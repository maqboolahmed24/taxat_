{
  "include": ["python/validators/src", "scripts/local", "scripts/test", "scripts/tasks", "scripts/agent"],
  "exclude": [
    "**/__pycache__",
    "python/generated_contract_models/src/taxat_generated_contract_models/generated",
    "node_modules",
    ".venv",
    "automation/provisioning/artifacts",
    "test-results",
    "native/TaxatOperator/.build"
  ],
  "venvPath": ".",
  "venv": ".venv",
  "typeCheckingMode": "basic",
  "strict": ["python/validators/src"],
  "reportMissingImports": "warning",
  "reportUnknownParameterType": "warning",
  "reportUnknownArgumentType": "warning",
  "reportUnknownLambdaType": "warning",
  "reportMissingTypeStubs": "none",
  "executionEnvironments": [
    {
      "root": "python/validators/src",
      "pythonVersion": "3.14"
    },
    {
      "root": "scripts/local",
      "pythonVersion": "3.14"
    },
    {
      "root": "scripts/test",
      "pythonVersion": "3.14"
    },
    {
      "root": "scripts/tasks",
      "pythonVersion": "3.14"
    },
    {
      "root": "scripts/agent",
      "pythonVersion": "3.14"
    }
  ]
}
