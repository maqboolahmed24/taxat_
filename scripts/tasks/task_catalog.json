{
  "catalogVersion": "TASK_CATALOG_V1",
  "catalogId": "repository_task_catalog",
  "basisStatement": "Make is the authoritative public task surface for humans and CI, while task_graph.py and the agent entrypoint scripts remain the machine-readable execution substrate for deterministic planning, dry runs, and guarded task execution.",
  "authoritativeInterface": {
    "interfaceRef": "make",
    "entrypoint": "Makefile",
    "secondaryInterfaces": [
      "scripts/tasks/task_graph.py",
      "scripts/agent/bootstrap_agent_workspace.sh",
      "scripts/agent/run_card_task.sh",
      "scripts/agent/verify_card_evidence.sh"
    ]
