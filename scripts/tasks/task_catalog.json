  "stateLayout": {
    "stateDir": ".tmp/task-runner",
    "planDir": ".tmp/task-runner/plans",
    "resultDir": ".tmp/task-runner/results",
    "logDir": ".tmp/task-runner/logs",
    "stdoutDir": ".tmp/task-runner/logs/stdout",
    "stderrDir": ".tmp/task-runner/logs/stderr"
  },
  "executionSemantics": {
    "dryRunDefault": false,
    "verboseDefault": false,
    "failFastDefault": true,
    "machineEventPrefix": "TASK_EVENT::",
    "dangerousAckArg": "--allow-dangerous",
    "profileArg": "--profile",
    "paramArg": "--param"
  },
  "environmentProfiles": [
    {
      "profileRef": "local",
      "label": "Local Authoring",
      "environmentRef": "env_local_authoring",
      "runtimeProfileRef": "local",
      "scopeClassRefOrNull": "LOCAL_HIGH_FIDELITY_SHARD",
      "destructiveProfileAllowed": true,
      "notes": [
        "Authoritative local workstation posture.",
        "Durable local resets still require typed confirmation tokens."
      ]
    },
    {
      "profileRef": "devcontainer",
      "label": "Devcontainer Authoring",
      "environmentRef": "env_local_authoring",
      "runtimeProfileRef": "devcontainer",
