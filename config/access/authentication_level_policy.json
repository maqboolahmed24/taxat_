{
  "contract_version": "AUTHENTICATION_LEVEL_POLICY_V1",
  "basis_statement": "Authentication-level policy keeps step-up and challenge rotation explicit instead of inferring them from route handlers or transient controller state.",
  "session_challenge_policy": {
    "step_up_freshness_window_seconds": 900,
    "satisfied_reason_code": "STEP_UP_EVIDENCE_FROZEN",
    "missing_reason_code": "STEP_UP_EVIDENCE_MISSING",
    "expired_reason_code": "STEP_UP_PROOF_EXPIRED",
    "rotation_required_after_completion": true,
    "invalidated_artifact_kinds": [
      "COMMAND_TOKEN",
      "RESUME_TOKEN",
      "UPLOAD_CONTROL"
    ]
  },
  "session_client_transition_rules": [
    {
      "session_client_class": "BROWSER",
      "principal_classes": [
        "HUMAN"
      ],
      "issuable_authn_levels": [
        "BASIC",
        "MFA",
        "STEP_UP"
      ],
      "step_up_completion_allowed": true
    },
    {
      "session_client_class": "NATIVE",
      "principal_classes": [
        "HUMAN"
      ],
      "issuable_authn_levels": [
        "BASIC",
        "MFA",
        "STEP_UP"
      ],
      "step_up_completion_allowed": true
    },
    {
      "session_client_class": "AUTOMATION",
      "principal_classes": [
        "SERVICE",
        "EXTERNAL"
      ],
      "issuable_authn_levels": [
        "BASIC"
      ],
      "step_up_completion_allowed": false
    }
  ],
  "rules": [
    {
      "rule_ref": "submit-to-authority",
      "resource_class": "SubmissionRecord",
      "action_family": "SUBMIT_TO_AUTHORITY",
      "required_authn_level": "STEP_UP",
      "reason_code": "STEP_UP_REQUIRED_FOR_AUTHORITY_SUBMISSION",
      "fresh_step_up_required": true,
      "policy_path_ref": "authentication_level_policy.rules.submit-to-authority"
    },
    {
      "rule_ref": "approve-config",
      "resource_class": "ConfigChangeRequest",
      "action_family": "APPROVE_CONFIG",
      "required_authn_level": "STEP_UP",
      "reason_code": "STEP_UP_REQUIRED_FOR_CONFIG_APPROVAL",
      "fresh_step_up_required": true,
      "policy_path_ref": "authentication_level_policy.rules.approve-config"
    },
    {
      "rule_ref": "approve-override",
      "resource_class": "Override",
      "action_family": "APPROVE_OVERRIDE",
      "required_authn_level": "STEP_UP",
      "reason_code": "STEP_UP_REQUIRED_FOR_OVERRIDE_APPROVAL",
      "fresh_step_up_required": true,
      "policy_path_ref": "authentication_level_policy.rules.approve-override"
    },
    {
      "rule_ref": "link-authority-software",
      "resource_class": "ConnectorBinding",
      "action_family": "LINK_AUTHORITY_SOFTWARE",
      "required_authn_level": "STEP_UP",
      "reason_code": "STEP_UP_REQUIRED_FOR_AUTHORITY_LINK",
      "fresh_step_up_required": true,
      "policy_path_ref": "authentication_level_policy.rules.link-authority-software"
    },
    {
      "rule_ref": "unlink-authority-software",
      "resource_class": "ConnectorBinding",
      "action_family": "UNLINK_AUTHORITY_SOFTWARE",
      "required_authn_level": "STEP_UP",
      "reason_code": "STEP_UP_REQUIRED_FOR_AUTHORITY_UNLINK",
      "fresh_step_up_required": true,
      "policy_path_ref": "authentication_level_policy.rules.unlink-authority-software"
    },
    {
      "rule_ref": "execute-retention",
      "resource_class": "RetentionAction",
      "action_family": "EXECUTE_RETENTION",
      "required_authn_level": "STEP_UP",
      "reason_code": "STEP_UP_REQUIRED_FOR_RETENTION_EXECUTION",
      "fresh_step_up_required": true,
      "policy_path_ref": "authentication_level_policy.rules.execute-retention"
    },
    {
      "rule_ref": "execute-erasure",
      "resource_class": "RetentionAction",
      "action_family": "EXECUTE_ERASURE",
      "required_authn_level": "STEP_UP",
      "reason_code": "STEP_UP_REQUIRED_FOR_ERASURE_EXECUTION",
      "fresh_step_up_required": true,
      "policy_path_ref": "authentication_level_policy.rules.execute-erasure"
    }
  ]
}
