{
  "contract_version": "BROWSER_SESSION_SECURITY_POLICY_V1",
  "basis_statement": "Browser session safety is explicit and server-mediated. Secure HttpOnly cookies remain necessary but insufficient: state-changing requests also require a synchronizer-token anti-CSRF proof and current session-binding validation against durable ActorSession truth.",
  "cookie_policy": {
    "secure_only": true,
    "http_only": true,
    "same_site": "STRICT",
    "path_scope": "TENANT_ORIGIN_PATH"
  },
  "binding_policy": {
    "require_session_binding_for_state_changing_requests": true,
    "accepted_session_binding_transports": [
      "SIGNED_ENVELOPE",
      "SAME_ORIGIN_HEADER"
    ]
  },
  "origin_policy": {
    "same_origin_required_for_state_changing_requests": true
  },
  "csrf_policy": {
    "mechanism": "SYNCHRONIZER_TOKEN",
    "state_changing_methods": [
      "POST",
      "PUT",
      "PATCH",
      "DELETE"
    ],
    "header_name": "x-taxat-csrf-token",
    "form_field_name": "csrf_token",
    "accepted_transport_locations": [
      "HEADER",
      "FORM_FIELD"
    ],
    "token_ttl_seconds": 1800,
    "max_active_tokens_per_session": 2,
    "rotation_events": [
      "SESSION_ISSUE",
      "STEP_UP_COMPLETION",
      "SESSION_REVOCATION"
    ],
    "persist_posture": "HASH_ONLY",
    "binding_inputs": [
      "tenant_id",
      "session_id",
      "csrf_ref",
      "session_binding_hash"
    ]
  }
}
