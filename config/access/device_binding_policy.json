{
  "contract_version": "DEVICE_BINDING_POLICY_V1",
  "basis_statement": "Session binding is the durable runtime proof. Native sessions treat a matching session-binding hash as the strong server-verified binding handle, while browser and native heuristic drift remains challenge-only evidence rather than ambient trust widening.",
  "browser_session_binding_policy": {
    "require_presented_session_binding": true,
    "canonical_session_binding_inputs": [
      "tenant_id",
      "session_id",
      "principal_ref",
      "session_client_class",
      "csrf_ref",
      "issued_at",
      "step_up_completed_at_or_null"
    ],
    "heuristic_signal_fields": [
      "network_fingerprint",
      "user_agent_family",
      "timezone",
      "client_instance_ref"
    ],
    "large_environment_change_threshold": 2
  },
  "native_device_binding_policy": {
    "strong_binding_mode": "SERVER_VERIFIED_SESSION_BINDING_HASH",
    "require_presented_session_binding": true,
    "mismatch_result": "REVOCATION_RECOMMENDED",
    "unverified_device_state_result": "CHALLENGE_REQUIRED",
    "canonical_session_binding_inputs": [
      "tenant_id",
      "session_id",
      "principal_ref",
      "session_client_class",
      "device_binding_state",
      "issued_at",
      "step_up_completed_at_or_null"
    ],
    "heuristic_signal_fields": [
      "network_fingerprint",
      "user_agent_family",
      "timezone",
      "client_instance_ref"
    ],
    "large_environment_change_threshold": 2
  },
  "automation_policy": {
    "device_binding_mode": "NOT_APPLICABLE",
    "session_binding_proof_optional": true
  }
}
