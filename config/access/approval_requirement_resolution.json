{
  "contract_version": "APPROVAL_REQUIREMENT_RESOLUTION_V1",
  "basis_statement": "Approval resolution keeps approval obligations, approver capability mapping, and requester-approver separation explicit instead of letting approval posture drift into workflow-local heuristics.",
  "governance_commit_posture_rules": {
    "PREVIEW_ONLY": {
      "approval_conversion_permitted": false,
      "reason_code": "GOVERNANCE_MUTATION_ADVISORY_ONLY"
    },
    "APPROVAL_GATED": {
      "approval_conversion_permitted": true,
      "reason_code": null
    },
    "BOUNDED_SAFE": {
      "approval_conversion_permitted": false,
      "reason_code": null
    }
  },
  "segregation_of_duties": {
    "forbid_requester_self_approval": true,
    "reason_code": "APPROVER_REQUESTER_SEPARATION_REQUIRED"
  },
  "capability_resolution": [
    {
      "capability": "SINGLE_APPROVER",
      "satisfies_approval_requirements": [
        "SINGLE_APPROVER"
      ],
      "satisfies_named_approvals": []
    },
    {
      "capability": "DUAL_APPROVER",
      "satisfies_approval_requirements": [
        "DUAL_APPROVER",
        "SINGLE_APPROVER"
      ],
      "satisfies_named_approvals": []
    },
    {
      "capability": "SECURITY_REVIEW",
      "satisfies_approval_requirements": [
        "SECURITY_REVIEW"
      ],
      "satisfies_named_approvals": []
    },
    {
      "capability": "CHANGE_BOARD",
      "satisfies_approval_requirements": [],
      "satisfies_named_approvals": [
        "CHANGE_BOARD"
      ]
    },
    {
      "capability": "SECURITY_TEAM",
      "satisfies_approval_requirements": [],
      "satisfies_named_approvals": [
        "SECURITY_TEAM"
      ]
    },
    {
      "capability": "TENANT_ADMIN",
      "satisfies_approval_requirements": [],
      "satisfies_named_approvals": [
        "TENANT_ADMIN"
      ]
    }
  ],
  "rules": [
    {
      "rule_ref": "create-override",
      "resource_class": "Override",
      "action_family": "CREATE_OVERRIDE",
      "approval_requirement": "SINGLE_APPROVER",
      "required_approvals": [
        "approval.override.single-approver"
      ],
      "reason_code": "APPROVAL_REQUIRED_FOR_OVERRIDE_CREATION",
      "policy_path_ref": "approval_requirement_resolution.rules.create-override"
    },
    {
      "rule_ref": "link-authority-software",
      "resource_class": "ConnectorBinding",
      "action_family": "LINK_AUTHORITY_SOFTWARE",
      "approval_requirement": "SINGLE_APPROVER",
      "required_approvals": [
        "approval.connector-link.single-approver"
      ],
      "reason_code": "APPROVAL_REQUIRED_FOR_AUTHORITY_LINK",
      "policy_path_ref": "approval_requirement_resolution.rules.link-authority-software"
    },
    {
      "rule_ref": "unlink-authority-software",
      "resource_class": "ConnectorBinding",
      "action_family": "UNLINK_AUTHORITY_SOFTWARE",
      "approval_requirement": "DUAL_APPROVER",
      "required_approvals": [
        "approval.connector-unlink.dual-approver"
      ],
      "reason_code": "APPROVAL_REQUIRED_FOR_AUTHORITY_UNLINK",
      "policy_path_ref": "approval_requirement_resolution.rules.unlink-authority-software"
    },
    {
      "rule_ref": "execute-retention",
      "resource_class": "RetentionAction",
      "action_family": "EXECUTE_RETENTION",
      "approval_requirement": "DUAL_APPROVER",
      "required_approvals": [
        "approval.retention.dual-approver"
      ],
      "reason_code": "APPROVAL_REQUIRED_FOR_RETENTION_EXECUTION",
      "policy_path_ref": "approval_requirement_resolution.rules.execute-retention"
    },
    {
      "rule_ref": "execute-erasure",
      "resource_class": "RetentionAction",
      "action_family": "EXECUTE_ERASURE",
      "approval_requirement": "SECURITY_REVIEW",
      "required_approvals": [
        "approval.erasure.security-review"
      ],
      "reason_code": "SECURITY_REVIEW_REQUIRED_FOR_ERASURE",
      "policy_path_ref": "approval_requirement_resolution.rules.execute-erasure"
    }
  ]
}
