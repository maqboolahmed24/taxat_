{
  "policy_version": "ACCESS_STEP_UP_POLICY_V1",
  "basis_statement": "Step-up policy isolates human authentication elevation from approval and delegation truth.",
  "rules": [
    {
      "rule_ref": "submit-to-authority",
      "resource_class": "SubmissionRecord",
      "action_family": "SUBMIT_TO_AUTHORITY",
      "required_authn_level": "STEP_UP",
      "reason_code": "STEP_UP_REQUIRED_FOR_AUTHORITY_SUBMISSION",
      "policy_path_ref": "step_up_policy.rules.submit-to-authority"
    },
    {
      "rule_ref": "approve-config",
      "resource_class": "ConfigChangeRequest",
      "action_family": "APPROVE_CONFIG",
      "required_authn_level": "STEP_UP",
      "reason_code": "STEP_UP_REQUIRED_FOR_CONFIG_APPROVAL",
      "policy_path_ref": "step_up_policy.rules.approve-config"
    },
    {
      "rule_ref": "approve-override",
      "resource_class": "Override",
      "action_family": "APPROVE_OVERRIDE",
      "required_authn_level": "STEP_UP",
      "reason_code": "STEP_UP_REQUIRED_FOR_OVERRIDE_APPROVAL",
      "policy_path_ref": "step_up_policy.rules.approve-override"
    },
    {
      "rule_ref": "link-authority-software",
      "resource_class": "ConnectorBinding",
      "action_family": "LINK_AUTHORITY_SOFTWARE",
      "required_authn_level": "STEP_UP",
      "reason_code": "STEP_UP_REQUIRED_FOR_AUTHORITY_LINK",
      "policy_path_ref": "step_up_policy.rules.link-authority-software"
    },
    {
      "rule_ref": "unlink-authority-software",
      "resource_class": "ConnectorBinding",
      "action_family": "UNLINK_AUTHORITY_SOFTWARE",
      "required_authn_level": "STEP_UP",
      "reason_code": "STEP_UP_REQUIRED_FOR_AUTHORITY_UNLINK",
      "policy_path_ref": "step_up_policy.rules.unlink-authority-software"
    }
  ]
}
