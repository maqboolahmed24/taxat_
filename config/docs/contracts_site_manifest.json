{
  "manifestVersion": "CONTRACTS_SITE_MANIFEST_V1",
  "routeId": "contracts-observatory",
  "title": "Taxat Contract Observatory",
  "subtitle": "Search-first internal library for authoritative prose, live schemas, samples, validators, generated bindings, readiness posture, and task traceability.",
  "siteSummary": "The observatory is the canonical internal contract atlas. It synthesizes the authoritative Algorithm corpus, imported schema mirror, local workspace schemas, bundled samples, validator entrypoints, binding coverage, drift readiness, and roadmap card references into one read-only inspection surface.",
  "navigationSchemaPath": "config/docs/contracts_navigation_schema.json",
  "sourceRoots": [
    {
      "root": "Algorithm",
      "includeGlobs": ["README.md", "*.md"],
      "artifactSourceRef": "ALGORITHM_MARKDOWN",
      "authorityLevel": "AUTHORITATIVE",
      "sourceTruthBadge": "Authoritative Algorithm Corpus"
    },
    {
      "root": "docs",
      "includeGlobs": ["**/*.md"],
      "artifactSourceRef": "SUPPORT_DOCS",
      "authorityLevel": "SUPPORTING_REFERENCE",
      "sourceTruthBadge": "Support Documentation"
    },
    {
      "root": "PROMPT/CARDS",
      "includeGlobs": ["pc_*.md"],
      "artifactSourceRef": "PROMPT_CARDS",
      "authorityLevel": "TRACEABILITY_REFERENCE",
      "sourceTruthBadge": "Roadmap Task Traceability"
    },
    {
      "root": "packages/contracts-core/schemas",
      "includeGlobs": ["*.schema.json"],
      "artifactSourceRef": "IMPORTED_SCHEMA_MIRROR",
      "authorityLevel": "AUTHORITATIVE",
      "sourceTruthBadge": "Imported Schema Mirror"
    },
    {
      "root": "schemas",
      "includeGlobs": ["*.schema.json"],
      "artifactSourceRef": "LOCAL_SCHEMA",
      "authorityLevel": "AUTHORITATIVE",
      "sourceTruthBadge": "Workspace Schema"
    },
    {
      "root": "config",
      "includeGlobs": ["**/*.schema.json"],
      "artifactSourceRef": "LOCAL_SCHEMA",
      "authorityLevel": "AUTHORITATIVE",
      "sourceTruthBadge": "Workspace Schema"
    },
    {
      "root": "packages/contracts-core/samples",
      "includeGlobs": ["sample_*.json"],
      "artifactSourceRef": "IMPORTED_SAMPLE_MIRROR",
      "authorityLevel": "AUTHORITATIVE",
      "sourceTruthBadge": "Imported Sample Mirror"
    },
    {
      "root": "packages/contracts-core/python",
      "includeGlobs": ["validate_contracts.py", "forensic_contract_guard.py"],
      "artifactSourceRef": "VALIDATOR_MIRROR",
      "authorityLevel": "AUTHORITATIVE",
      "sourceTruthBadge": "Validator Mirror"
    }
  ],
  "outputPaths": {
    "siteManifest": "apps/operator-web/public/internal/contracts-observatory/data/site-manifest.json",
    "navigationIndex": "apps/operator-web/public/internal/contracts-observatory/data/navigation-index.json",
    "searchIndex": "apps/operator-web/public/internal/contracts-observatory/data/search-index.json",
    "schemaCrosslinkGraph": "apps/operator-web/public/internal/contracts-observatory/data/schema-crosslink-graph.json",
    "bindingCatalog": "apps/operator-web/public/internal/contracts-observatory/data/binding-catalog.json",
    "artifactsDirectory": "apps/operator-web/public/internal/contracts-observatory/data/artifacts"
  },
  "viewPolicies": {
    "commandSearchLimit": 18,
    "recentArtifactLimit": 8,
    "largeSchemaFieldCollapseThreshold": 14,
    "proseExcerptLength": 180
  }
}
