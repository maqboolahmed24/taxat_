{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taxat.dev/schemas/time_profile.schema.json",
  "title": "Time Profile",
  "type": "object",
  "required": [
    "contract_version",
    "profile_id",
    "basis_statement",
    "source_lineage",
    "canonical_instant_shape",
    "business_date_shape",
    "period_families",
    "instant_examples",
    "business_date_examples",
    "period_examples",
    "display_example",
    "forbidden_cases"
  ],
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "basis_statement": {
      "type": "string"
    },
    "source_lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_file", "source_heading_or_logical_block", "rationale"],
        "properties": {
          "source_file": {
            "type": "string"
          },
          "source_heading_or_logical_block": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "canonical_instant_shape": {
      "type": "string"
    },
    "business_date_shape": {
      "type": "string"
    },
    "period_families": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "instant_examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_ref", "label", "input", "expected"],
        "properties": {
          "case_ref": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "input": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "business_date_examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_ref", "label", "input"],
        "properties": {
          "case_ref": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "input": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "period_examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_ref", "label", "family", "input"],
        "properties": {
          "case_ref": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "family": {
            "type": "string"
          },
          "input": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "display_example": {
      "type": "object",
      "required": ["input", "locale", "timeZone", "note"],
      "properties": {
        "input": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "timeZone": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "forbidden_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "input", "reason"],
        "properties": {
          "label": {
            "type": "string"
          },
          "input": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
