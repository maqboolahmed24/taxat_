{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taxat.dev/schemas/identifier_family_catalog.schema.json",
  "title": "Identifier Family Catalog",
  "type": "object",
  "required": [
    "contract_version",
    "catalog_id",
    "basis_statement",
    "source_lineage",
    "identifier_families"
  ],
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "catalog_id": {
      "type": "string"
    },
    "basis_statement": {
      "type": "string"
    },
    "source_lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_file", "source_heading_or_logical_block", "rationale"],
        "properties": {
          "source_file": {
            "type": "string"
          },
          "source_heading_or_logical_block": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "identifier_families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "family_ref",
          "label",
          "brand_suffix",
          "helper_ref",
          "schema_suffixes",
          "allowed_shape",
          "summary",
          "notes",
          "example_fields",
          "forbidden_shortcuts"
        ],
        "properties": {
          "family_ref": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "brand_suffix": {
            "type": "string"
          },
          "helper_ref": {
            "type": "string"
          },
          "schema_suffixes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed_shape": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "example_fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["field_name", "family", "literal", "note"],
              "properties": {
                "field_name": {
                  "type": "string"
                },
                "family": {
                  "type": "string"
                },
                "literal": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "forbidden_shortcuts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
