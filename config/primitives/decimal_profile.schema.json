{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taxat.dev/schemas/decimal_profile.schema.json",
  "title": "Decimal Profile",
  "type": "object",
  "required": [
    "contract_version",
    "profile_id",
    "basis_statement",
    "source_lineage",
    "storage_posture",
    "representation",
    "forbidden_inputs",
    "literal_examples",
    "operation_examples",
    "comparison_examples"
  ],
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "basis_statement": {
      "type": "string"
    },
    "source_lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_file", "source_heading_or_logical_block", "rationale"],
        "properties": {
          "source_file": {
            "type": "string"
          },
          "source_heading_or_logical_block": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "storage_posture": {
      "type": "string"
    },
    "representation": {
      "type": "string"
    },
    "forbidden_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "literal", "reason"],
        "properties": {
          "label": {
            "type": "string"
          },
          "literal": {},
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "literal_examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_ref", "label", "literal", "scale"],
        "properties": {
          "case_ref": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "literal": {
            "type": "string"
          },
          "scale": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "operation_examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_ref", "label", "operation", "left", "right", "expected"],
        "properties": {
          "case_ref": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "left": {
            "type": "string"
          },
          "right": {
            "type": "string"
          },
          "explicit_scale": {
            "type": "integer",
            "minimum": 0
          },
          "expected": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "comparison_examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_ref",
          "label",
          "left",
          "right",
          "expected_numeric_relation",
          "expected_representation_equal"
        ],
        "properties": {
          "case_ref": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "left": {
            "type": "string"
          },
          "right": {
            "type": "string"
          },
          "expected_numeric_relation": {
            "type": "string"
          },
          "expected_representation_equal": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
