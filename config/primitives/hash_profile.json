{
  "$schema": "./hash_profile.schema.json",
  "contract_version": "1.0",
  "profile_id": "canonical_hash_profile_v1",
  "basis_statement": "Canonical hashes use SHA-256 over deterministic JSON with Unicode NFC normalization, lexicographically ordered object keys, preserved array order, and explicit nulls.",
  "source_lineage": [
    {
      "source_file": "implementation_conventions.md",
      "source_heading_or_logical_block": "deterministic serialization and hashing",
      "rationale": "Canonical JSON rules for ordering, normalization, and replay-safe byte generation originate here."
    },
    {
      "source_file": "replay_and_reproducibility_contract.md",
      "source_heading_or_logical_block": "canonical deterministic outcome formulas",
      "rationale": "Replay-safe hashing and normalized payload expectations are binding for manifest and execution truth."
    },
    {
      "source_file": "authority_interaction_protocol.md",
      "source_heading_or_logical_block": "duplicate_meaning_key, request_hash, and idempotency_key identity formulas",
      "rationale": "Authority hashes must remain aligned with validator-enforced request identity logic."
    },
    {
      "source_file": "Algorithm/scripts/validate_contracts.py",
      "source_heading_or_logical_block": "stable_json_hash and authority request identity helpers",
      "rationale": "Executable validator behavior is the authoritative parity oracle for request-hash derivation."
    }
  ],
  "algorithm": "SHA-256",
  "digest_encoding": "LOWERCASE_HEX",
  "serialization": {
    "profile_ref": "CANONICAL_JSON_V1",
    "string_normalization": "UNICODE_NFC",
    "object_key_order": "LEXICOGRAPHIC_ASCENDING",
    "array_ordering": "PRESERVE_DECLARED_ORDER",
    "set_like_array_helper": "sortSetLikeStrings",
    "null_policy": "EXPLICIT_NULL_REQUIRED",
    "ascii_escape_policy": "JSON_ENSURE_ASCII",
    "time_normalization": "NORMALIZE_INSTANTS_TO_UTC_BEFORE_HASHING_WHEN_TIME_VALUES_ARE_BOUND",
    "forbidden_inputs": [
      "undefined",
      "NaN",
      "Infinity",
      "-Infinity",
      "-0",
      "bigint",
      "function",
      "symbol",
      "non-plain-object instances"
    ]
  },
  "helper_catalog": [
    {
      "helper_ref": "canonicalJsonStringify",
      "purpose": "Serialize canonical JSON bytes without whitespace drift.",
      "notes": [
        "Strings normalize to NFC before emission.",
        "Objects reject duplicate normalized keys."
      ]
    },
    {
      "helper_ref": "stableJsonHash",
      "purpose": "Generate a canonical SHA-256 digest from deterministic JSON bytes.",
      "notes": [
        "Digest output is lowercase hexadecimal.",
        "Used by request, replay, and config-surface identity records."
      ]
    },
    {
      "helper_ref": "stableQueryString",
      "purpose": "Encode query parameters deterministically without sorting set-like arrays implicitly.",
      "notes": ["Keys are sorted lexicographically.", "Value arrays preserve declared order."]
    },
    {
      "helper_ref": "stablePath",
      "purpose": "Fill URI templates without emitting partial or malformed path tokens.",
      "notes": [
        "Missing or empty path parameters fail closed.",
        "Resolved values use RFC 3986 encoding."
      ]
    },
    {
      "helper_ref": "deriveAuthorityDuplicateMeaningKey",
      "purpose": "Derive the canonical duplicate-meaning key for authority requests.",
      "notes": [
        "Business partition refs remain in declared order unless a caller explicitly sorts a set-like source.",
        "Shares the identity namespace hash seed with request_hash and idempotency_key."
      ]
    }
  ],
  "canonical_examples": [
    {
      "case_ref": "unicode_and_array_order",
      "label": "Unicode normalization plus preserved array order",
      "payload": {
        "beta": "Café",
        "alpha": ["late", "amendment"],
        "explicit": null
      },
      "note": "The decomposed accent in Café normalizes to NFC, object keys reorder lexicographically, and the tags array preserves declared order."
    }
  ],
  "query_examples": [
    {
