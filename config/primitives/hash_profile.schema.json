{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taxat.dev/schemas/hash_profile.schema.json",
  "title": "Hash Profile",
  "type": "object",
  "required": [
    "contract_version",
    "profile_id",
    "basis_statement",
    "source_lineage",
    "algorithm",
    "digest_encoding",
    "serialization",
    "helper_catalog",
    "canonical_examples",
    "query_examples",
    "path_examples",
    "authority_examples"
  ],
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "basis_statement": {
      "type": "string"
    },
    "source_lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_file", "source_heading_or_logical_block", "rationale"],
        "properties": {
          "source_file": {
            "type": "string"
          },
          "source_heading_or_logical_block": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "algorithm": {
      "type": "string"
    },
    "digest_encoding": {
      "type": "string"
    },
    "serialization": {
      "type": "object",
      "required": [
        "profile_ref",
        "string_normalization",
        "object_key_order",
        "array_ordering",
        "set_like_array_helper",
        "null_policy",
        "ascii_escape_policy",
        "time_normalization",
        "forbidden_inputs"
      ],
      "properties": {
        "profile_ref": {
          "type": "string"
        },
        "string_normalization": {
          "type": "string"
        },
        "object_key_order": {
          "type": "string"
        },
        "array_ordering": {
          "type": "string"
        },
        "set_like_array_helper": {
          "type": "string"
        },
        "null_policy": {
          "type": "string"
        },
        "ascii_escape_policy": {
          "type": "string"
        },
        "time_normalization": {
          "type": "string"
        },
        "forbidden_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "helper_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["helper_ref", "purpose", "notes"],
        "properties": {
          "helper_ref": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "canonical_examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_ref", "label", "payload", "note"],
        "properties": {
          "case_ref": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "payload": {},
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "query_examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_ref", "label", "query", "expected"],
        "properties": {
          "case_ref": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "query": {
            "type": "object"
          },
          "expected": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "path_examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_ref", "label", "template", "params", "expected"],
        "properties": {
          "case_ref": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "template": {
            "type": "string"
          },
          "params": {
            "type": "object"
          },
          "expected": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "authority_examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_ref",
          "label",
          "payload",
          "resource_template",
          "path_params",
          "query_params",
          "normalized_obligation_ref",
          "normalized_basis_type"
        ],
        "properties": {
          "case_ref": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          },
          "resource_template": {
            "type": "string"
          },
          "path_params": {
            "type": "object"
          },
          "query_params": {
            "type": "object"
          },
          "normalized_obligation_ref": {
            "type": "string"
          },
          "normalized_basis_type": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
