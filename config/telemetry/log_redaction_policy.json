{
  "schema_version": "1.0",
  "policy_id": "log_redaction_policy",
  "redacted_value": "[REDACTED]",
  "forbidden_field_patterns": [
    "([Pp][Aa][Ss][Ss](word|wd)?)",
    "([Ss][Ee][Cc][Rr][Ee][Tt])",
    "([Tt][Oo][Kk][Ee][Nn])",
    "([Aa][Uu][Tt][Hh](orization)?)",
    "([Cc][Oo][Oo][Kk][Ii][Ee])",
    "([Dd][Oo][Mm][-_]?[Ss][Nn][Aa][Pp][Ss][Hh][Oo][Tt])",
    "([Ss][Cc][Rr][Ee][Ee][Nn][Ss][Hh][Oo][Tt])",
    "([Cc][Ll][Ii][Pp][Bb][Oo][Aa][Rr][Dd])"
  ],
  "client_surface_forbidden_keys": [
    "approval_rationale",
    "clipboard_contents",
    "declaration_text",
    "document_filename",
    "dom_snapshot",
    "evidence_excerpt",
    "keystroke_stream",
    "request_text",
    "screenshot_payload",
    "ui_text"
  ],
  "client_surface_allowed_fields": [
    "action_code",
    "accessibility_pref",
    "error_code",
    "module_code",
    "opaque_object_ref",
    "performance_bucket_ms",
    "posture_code",
    "recovery_outcome",
    "route_family",
    "shell_family"
  ],
  "family_policies": [
    {
      "log_family": "RUNTIME",
      "access_tier": "STANDARD_OPERATIONS",
      "allowed_structured_fields": [
        "action_code",
        "accessibility_pref",
        "error_code",
        "failure_class",
        "failure_phase",
        "latency_bucket_ms",
        "module_code",
        "opaque_object_ref",
        "performance_bucket_ms",
        "posture_code",
        "queue_family_ref",
        "recovery_outcome",
        "reason_code",
        "route_family",
        "sampling_class",
        "shell_family",
        "stream_scope_class",
        "upload_session_id"
      ],
      "hashed_only_fields": [],
      "notes": [
        "Runtime logs keep event codes and typed operational fields only.",
        "No copied payload text, request bodies, or document fragments are allowed."
      ]
    },
    {
      "log_family": "SESSION_SECURITY",
      "access_tier": "SECURITY_RESTRICTED",
      "allowed_structured_fields": [
        "reason_code",
        "session_ref",
        "step_up_posture"
      ],
      "hashed_only_fields": [],
      "notes": [
        "Session security logs keep only safe refs and posture codes."
      ]
    },
    {
      "log_family": "ACCESS_CONTROL",
      "access_tier": "SECURITY_RESTRICTED",
      "allowed_structured_fields": [
        "access_binding_hash",
        "policy_snapshot_hash",
        "reason_code"
      ],
      "hashed_only_fields": [],
      "notes": [
        "Access control logs retain hashes and reason codes only."
      ]
    },
    {
      "log_family": "PRIVACY_RETENTION",
      "access_tier": "PRIVACY_RESTRICTED",
      "allowed_structured_fields": [
        "artifact_retention_ref",
        "limitation_reason_code",
        "opaque_object_ref",
        "reason_code",
        "retention_class"
      ],
      "hashed_only_fields": [],
      "notes": [
        "Privacy and retention logs keep policy-safe refs only."
      ]
    },
    {
      "log_family": "AUTHORITY_EDGE",
      "access_tier": "SECURITY_RESTRICTED",
      "allowed_structured_fields": [
        "access_binding_hash",
        "authority_binding_ref",
        "authority_operation_ref",
        "reason_code",
        "submission_record_id"
      ],
      "hashed_only_fields": [],
      "notes": [
        "Authority-edge logs keep safe authority refs and hashes only."
      ]
    }
  ]
}
