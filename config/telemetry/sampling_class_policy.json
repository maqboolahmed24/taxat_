{
  "schema_version": "1.0",
  "policy_id": "sampling_class_policy",
  "audit_join_boundary": "TELEMETRY_CORRELATES_TO_AUDIT_BUT_DOES_NOT_REPLACE_IT",
  "default_trace_retention_class": "retention.telemetry.trace_hot_14d",
  "default_metric_retention_class": "retention.telemetry.metric_rollup_30d",
  "sampling_class_rows": [
    {
      "sampling_class_ref": "MANDATORY_FORENSIC",
      "label": "Mandatory forensic",
      "default_retention_class": "retention.telemetry.trace_hot_14d",
      "sampled_out_behavior": "NEVER_SAMPLE_OUT",
      "notes": [
        "Authority, filing, amendment, retention, and erasure spans must remain retained.",
        "Sampling posture may not weaken audit evidence."
      ]
    },
    {
      "sampling_class_ref": "DETERMINISTIC_RETAIN",
      "label": "Deterministic retain",
      "default_retention_class": "retention.telemetry.trace_hot_14d",
      "sampled_out_behavior": "RETAIN_FOR_BRANCH_AND_RUN_EXPLANATION",
      "notes": [
        "Run-root and lineage-decision spans remain retained deterministically.",
        "Use when replay, continuation, or worker continuity would become opaque otherwise."
      ]
    },
    {
      "sampling_class_ref": "SAMPLED_OPERATIONAL",
      "label": "Sampled operational",
      "default_retention_class": "retention.telemetry.trace_hot_14d",
      "sampled_out_behavior": "MAY_SAMPLE_TRACE_BUT_KEEP_AUDIT_AND_METRIC_JOIN_KEYS",
      "notes": [
        "Operational spans may sample out when audit and metric joins remain sufficient.",
        "Never use this for compliance-significant mutations."
      ]
    },
    {
      "sampling_class_ref": "CLIENT_LOW_NOISE",
      "label": "Client low-noise",
      "default_retention_class": "retention.telemetry.client_low_noise_7d",
      "sampled_out_behavior": "LOW_NOISE_CLIENT_CODES_ONLY",
      "notes": [
        "Client surfaces record route/module/posture/timing codes only.",
        "No copied UI text or payload fragments survive."
      ]
    }
  ],
  "span_code_rules": [
    {
      "span_code": "RUN_ROOT",
      "sampling_class_ref": "DETERMINISTIC_RETAIN",
      "retention_class": "retention.telemetry.trace_hot_14d"
    },
    {
      "span_code": "PRIOR_MANIFEST_CONTEXT_LOAD",
      "sampling_class_ref": "DETERMINISTIC_RETAIN",
      "retention_class": "retention.telemetry.trace_hot_14d"
    },
    {
      "span_code": "REUSE_CONTINUATION_DECISION",
      "sampling_class_ref": "DETERMINISTIC_RETAIN",
      "retention_class": "retention.telemetry.trace_hot_14d"
    },
    {
      "span_code": "CONFIG_RESOLVE_OR_INHERITANCE_DECISION",
      "sampling_class_ref": "DETERMINISTIC_RETAIN",
      "retention_class": "retention.telemetry.trace_hot_14d"
    },
    {
      "span_code": "EXISTING_DECISION_BUNDLE_RELOAD",
      "sampling_class_ref": "DETERMINISTIC_RETAIN",
      "retention_class": "retention.telemetry.trace_hot_14d"
    },
    {
      "span_code": "MANIFEST_FREEZE",
      "sampling_class_ref": "DETERMINISTIC_RETAIN",
      "retention_class": "retention.telemetry.trace_hot_14d"
    },
    {
      "span_code": "SOURCE_COLLECTION",
      "sampling_class_ref": "SAMPLED_OPERATIONAL",
      "retention_class": "retention.telemetry.trace_hot_14d"
    },
    {
      "span_code": "SNAPSHOT_BUILD",
      "sampling_class_ref": "SAMPLED_OPERATIONAL",
      "retention_class": "retention.telemetry.trace_hot_14d"
    },
    {
      "span_code": "COMPUTE",
      "sampling_class_ref": "SAMPLED_OPERATIONAL",
      "retention_class": "retention.telemetry.trace_hot_14d"
    },
    {
      "span_code": "PARITY",
      "sampling_class_ref": "SAMPLED_OPERATIONAL",
      "retention_class": "retention.telemetry.trace_hot_14d"
    },
    {
      "span_code": "TRUST",
      "sampling_class_ref": "SAMPLED_OPERATIONAL",
      "retention_class": "retention.telemetry.trace_hot_14d"
    },
    {
      "span_code": "GRAPH_BUILD",
      "sampling_class_ref": "SAMPLED_OPERATIONAL",
      "retention_class": "retention.telemetry.trace_hot_14d"
    },
    {
      "span_code": "FILING_PACKET_BUILD",
      "sampling_class_ref": "MANDATORY_FORENSIC",
      "retention_class": "retention.telemetry.trace_hot_14d"
    },
    {
      "span_code": "AUTHORITY_REQUEST_BUILD",
      "sampling_class_ref": "MANDATORY_FORENSIC",
      "retention_class": "retention.telemetry.trace_hot_14d"
    },
    {
      "span_code": "AUTHORITY_TRANSMIT",
      "sampling_class_ref": "MANDATORY_FORENSIC",
      "retention_class": "retention.telemetry.trace_hot_14d"
    },
    {
      "span_code": "AUTHORITY_RECONCILE",
      "sampling_class_ref": "MANDATORY_FORENSIC",
      "retention_class": "retention.telemetry.trace_hot_14d"
    },
    {
      "span_code": "DRIFT_DETECT",
      "sampling_class_ref": "MANDATORY_FORENSIC",
      "retention_class": "retention.telemetry.trace_hot_14d"
    },
    {
      "span_code": "AMENDMENT_EVALUATE",
      "sampling_class_ref": "MANDATORY_FORENSIC",
      "retention_class": "retention.telemetry.trace_hot_14d"
    },
    {
      "span_code": "RETENTION_APPLY",
      "sampling_class_ref": "MANDATORY_FORENSIC",
      "retention_class": "retention.telemetry.trace_hot_14d"
    },
    {
      "span_code": "ERASURE_EXECUTE",
      "sampling_class_ref": "MANDATORY_FORENSIC",
      "retention_class": "retention.telemetry.trace_hot_14d"
    },
    {
      "span_code": "OTHER",
      "sampling_class_ref": "SAMPLED_OPERATIONAL",
      "retention_class": "retention.telemetry.trace_hot_14d"
    }
  ],
  "metric_family_rules": [
    {
      "metric_family": "MODULE_LATENCY",
      "instrument_kind": "HISTOGRAM",
      "retention_class": "retention.telemetry.metric_rollup_30d"
    },
    {
      "metric_family": "QUEUE_DELAY",
      "instrument_kind": "HISTOGRAM",
      "retention_class": "retention.telemetry.metric_rollup_30d"
    },
    {
      "metric_family": "EXPERIENCE_STREAM_RESUME_REBASE_RATE",
      "instrument_kind": "COUNTER",
      "retention_class": "retention.telemetry.metric_rollup_30d"
    },
    {
      "metric_family": "STALE_VIEW_CONFLICT_RATE",
      "instrument_kind": "COUNTER",
      "retention_class": "retention.telemetry.metric_rollup_30d"
    },
    {
      "metric_family": "ACCESS_DENIALS",
      "instrument_kind": "COUNTER",
      "retention_class": "retention.telemetry.metric_rollup_30d"
    },
    {
      "metric_family": "SESSION_REVOCATIONS",
      "instrument_kind": "COUNTER",
      "retention_class": "retention.telemetry.metric_rollup_30d"
    }
  ],
  "log_family_rules": [
    {
      "log_family": "RUNTIME",
      "access_tier": "STANDARD_OPERATIONS",
      "retention_class": "retention.telemetry.logs_hot_30d"
    },
    {
      "log_family": "SESSION_SECURITY",
      "access_tier": "SECURITY_RESTRICTED",
      "retention_class": "retention.telemetry.security_30d"
    },
    {
      "log_family": "ACCESS_CONTROL",
      "access_tier": "SECURITY_RESTRICTED",
      "retention_class": "retention.telemetry.security_30d"
    },
    {
      "log_family": "PRIVACY_RETENTION",
      "access_tier": "PRIVACY_RESTRICTED",
      "retention_class": "retention.telemetry.privacy_30d"
    },
    {
      "log_family": "AUTHORITY_EDGE",
      "access_tier": "SECURITY_RESTRICTED",
      "retention_class": "retention.telemetry.security_30d"
    }
  ]
}
