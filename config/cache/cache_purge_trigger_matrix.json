{
  "contract_version": "CACHE_PURGE_TRIGGER_MATRIX_V1",
  "matrix_id": "cache_purge_trigger_matrix",
  "basis_statement": "Binding drift purges the exact cache layers and local artifacts that could otherwise replay stale legal posture after tenant, session, access, masking, route, preview, or schema changes.",
  "trigger_rows": [
    {
      "trigger_code": "TENANT_SWITCH",
      "display_name": "Tenant switch",
      "mismatch_fields": ["tenant_id"],
      "purge_artifact_classes": ["SHARED_CACHE_ENTRY", "STRUCTURED_CACHE", "RESUME_METADATA", "SCENE_RESTORATION_PAYLOAD", "NSUSERACTIVITY", "PREVIEW_CACHE", "TEMP_EXPORT_FILE", "LOCAL_SEARCH_INDEX"],
      "shared_cache_action": "PURGE_ALL_SCOPE_VARIANTS",
      "local_restore_posture": "DENY_RESTORE",
      "notes": ["Tenant drift invalidates every cached interpretation of the mounted route or native scene."]
    },
    {
      "trigger_code": "CLIENT_BINDING_CHANGE",
      "display_name": "Client binding change",
      "mismatch_fields": ["client_id_or_null"],
      "purge_artifact_classes": ["SHARED_CACHE_ENTRY", "STRUCTURED_CACHE", "RESUME_METADATA", "SCENE_RESTORATION_PAYLOAD", "PREVIEW_CACHE", "TEMP_EXPORT_FILE", "LOCAL_SEARCH_INDEX"],
      "shared_cache_action": "PURGE_ALL_SCOPE_VARIANTS",
      "local_restore_posture": "DENY_RESTORE",
      "notes": ["Client binding drift is a different request or portal audience boundary and cannot reuse cached slices."]
    },
    {
      "trigger_code": "PRINCIPAL_CLASS_CHANGE",
      "display_name": "Principal class change",
      "mismatch_fields": ["principal_class"],
      "purge_artifact_classes": ["SHARED_CACHE_ENTRY", "STRUCTURED_CACHE", "RESUME_METADATA", "SCENE_RESTORATION_PAYLOAD", "NSUSERACTIVITY", "PREVIEW_CACHE", "TEMP_EXPORT_FILE", "LOCAL_SEARCH_INDEX"],
      "shared_cache_action": "PURGE_ALL_SCOPE_VARIANTS",
      "local_restore_posture": "DENY_RESTORE",
      "notes": ["Principal class drift changes legal posture even if the route and object anchor remain the same."]
    },
    {
      "trigger_code": "SESSION_BINDING_CHANGE",
      "display_name": "Session binding change",
      "mismatch_fields": ["session_binding_hash"],
      "purge_artifact_classes": ["SHARED_CACHE_ENTRY", "STRUCTURED_CACHE", "RESUME_METADATA", "SCENE_RESTORATION_PAYLOAD", "NSUSERACTIVITY", "PREVIEW_CACHE", "TEMP_EXPORT_FILE", "LOCAL_SEARCH_INDEX"],
      "shared_cache_action": "PURGE_ALL_SCOPE_VARIANTS",
      "local_restore_posture": "DENY_RESTORE",
      "notes": ["Session binding drift invalidates browser restore, native restore, and resume metadata together."]
    },
    {
      "trigger_code": "ACCESS_BINDING_CHANGE",
      "display_name": "Access binding change",
      "mismatch_fields": ["access_binding_hash_or_null"],
      "purge_artifact_classes": ["SHARED_CACHE_ENTRY", "STRUCTURED_CACHE", "RESUME_METADATA", "PREVIEW_CACHE", "TEMP_EXPORT_FILE", "LOCAL_SEARCH_INDEX"],
      "shared_cache_action": "PURGE_ALL_SCOPE_VARIANTS",
      "local_restore_posture": "DENY_RESTORE",
      "notes": ["Access drift purges broader variants immediately because weaker keys could replay unauthorized rows or affordances."]
    },
    {
      "trigger_code": "MASKING_CHANGE",
      "display_name": "Masking posture change",
      "mismatch_fields": ["masking_posture_fingerprint_or_null"],
      "purge_artifact_classes": ["SHARED_CACHE_ENTRY", "STRUCTURED_CACHE", "RESUME_METADATA", "PREVIEW_CACHE", "TEMP_EXPORT_FILE", "LOCAL_SEARCH_INDEX"],
      "shared_cache_action": "PURGE_ALL_SCOPE_VARIANTS",
      "local_restore_posture": "DENY_RESTORE",
      "notes": ["Masking tightening invalidates all broader variants and their local derivatives, not only the structured cache row."]
    },
    {
      "trigger_code": "VISIBILITY_PARTITION_CHANGE",
      "display_name": "Visibility partition change",
      "mismatch_fields": ["visibility_cache_partition_key_or_null", "cache_partition_ref"],
      "purge_artifact_classes": ["SHARED_CACHE_ENTRY", "STRUCTURED_CACHE", "PREVIEW_CACHE", "TEMP_EXPORT_FILE", "LOCAL_SEARCH_INDEX"],
      "shared_cache_action": "PURGE_ALL_SCOPE_VARIANTS",
      "local_restore_posture": "DENY_RESTORE",
      "notes": ["List and workspace slices purge when the visibility partition changes even if route and object refs stay stable."]
    },
    {
      "trigger_code": "ROUTE_OR_OBJECT_DRIFT",
      "display_name": "Route or object drift",
      "mismatch_fields": ["cache_scope_class", "route_identity_ref", "canonical_object_ref", "shell_family", "shell_stability_ref_or_null"],
      "purge_artifact_classes": ["SHARED_CACHE_ENTRY", "STRUCTURED_CACHE", "SCENE_RESTORATION_PAYLOAD", "NSUSERACTIVITY", "PREVIEW_CACHE", "TEMP_EXPORT_FILE", "LOCAL_SEARCH_INDEX"],
      "shared_cache_action": "PURGE_MATCHING_SCOPE",
      "local_restore_posture": "DENY_RESTORE",
      "notes": ["Route, object, or shell drift blocks hydration and forces the mounted surface back through explicit truth selection."]
    },
    {
      "trigger_code": "SCHEMA_INCOMPATIBLE",
      "display_name": "Schema or projection incompatibility",
      "mismatch_fields": ["projection_version_ref"],
      "purge_artifact_classes": ["SHARED_CACHE_ENTRY", "STRUCTURED_CACHE", "RESUME_METADATA", "SCENE_RESTORATION_PAYLOAD", "NSUSERACTIVITY", "PREVIEW_CACHE", "TEMP_EXPORT_FILE", "LOCAL_SEARCH_INDEX"],
      "shared_cache_action": "PURGE_MATCHING_SCOPE",
      "local_restore_posture": "DENY_RESTORE",
      "notes": ["Projection-version drift is treated as schema incompatibility and purges before render rather than replaying stale structure."]
    },
    {
      "trigger_code": "PREVIEW_SELECTION_DRIFT",
      "display_name": "Preview selection drift",
      "mismatch_fields": ["preview_subject_ref_or_null"],
      "purge_artifact_classes": ["PREVIEW_CACHE", "TEMP_EXPORT_FILE", "NSUSERACTIVITY", "LOCAL_SEARCH_INDEX"],
      "shared_cache_action": "PURGE_MATCHING_SCOPE",
      "local_restore_posture": "DENY_RESTORE",
      "notes": ["Detached compare, packet, and preview windows purge local preview derivatives as soon as selected subject changes."]
    },
    {
      "trigger_code": "DELIVERY_BINDING_DRIFT",
      "display_name": "Delivery binding drift",
      "mismatch_fields": ["delivery_binding_hash"],
      "purge_artifact_classes": ["SHARED_CACHE_ENTRY", "PREVIEW_CACHE", "TEMP_EXPORT_FILE"],
      "shared_cache_action": "PURGE_MATCHING_SCOPE",
      "local_restore_posture": "DENY_RESTORE",
      "notes": ["A non-canonical delivery binding hash is treated as tamper or stale affinity and invalidates preview/export reuse immediately."]
    }
  ],
