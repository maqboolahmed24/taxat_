{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taxat.dev/config/references/delivery_binding_policy.schema.json",
  "title": "Delivery Binding Policy",
  "type": "object",
  "required": [
    "$schema",
    "contract_version",
    "policy_id",
    "basis_statement",
    "source_lineage",
    "binding_dimensions",
    "forbidden_content",
    "delivery_rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "contract_version": {
      "type": "string"
    },
    "policy_id": {
      "type": "string"
    },
    "basis_statement": {
      "type": "string"
    },
    "source_lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_file", "source_heading_or_logical_block", "rationale"],
        "properties": {
          "source_file": {
            "type": "string"
          },
          "source_heading_or_logical_block": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "binding_dimensions": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "forbidden_content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "delivery_rows": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "affordance_ref",
          "target_fields",
          "required_context_fields",
          "forbidden_shortcuts",
          "lawful_examples",
          "notes"
        ],
        "properties": {
          "affordance_ref": {
            "type": "string"
          },
          "target_fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "required_context_fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "forbidden_shortcuts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lawful_examples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
