{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taxat.dev/config/references/artifact_locator_strategy.schema.json",
  "title": "Artifact Locator Strategy",
  "type": "object",
  "required": [
    "$schema",
    "contract_version",
    "strategy_id",
    "basis_statement",
    "source_lineage",
    "locator_rows",
    "selection_rules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "contract_version": {
      "type": "string"
    },
    "strategy_id": {
      "type": "string"
    },
    "basis_statement": {
      "type": "string"
    },
    "source_lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_file", "source_heading_or_logical_block", "rationale"],
        "properties": {
          "source_file": {
            "type": "string"
          },
          "source_heading_or_logical_block": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "locator_rows": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "locator_family_ref",
          "shape",
          "durability_posture",
          "resolution_context",
          "human_readability_posture",
          "move_or_copy_behavior",
          "forbidden_content",
          "lawful_examples",
          "notes"
        ],
        "properties": {
          "locator_family_ref": {
            "type": "string"
          },
          "shape": {
            "type": "string"
          },
          "durability_posture": {
            "type": "string"
          },
          "resolution_context": {
            "type": "string"
          },
          "human_readability_posture": {
            "type": "string"
          },
          "move_or_copy_behavior": {
            "type": "string"
          },
          "forbidden_content": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lawful_examples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "selection_rules": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["rule_ref", "statement", "notes"],
        "properties": {
          "rule_ref": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
