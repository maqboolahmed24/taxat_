{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taxat.dev/config/references/reference_key_grammar.schema.json",
  "title": "Reference Key Grammar",
  "type": "object",
  "required": [
    "$schema",
    "contract_version",
    "grammar_id",
    "grammar_badge",
    "basis_statement",
    "source_lineage",
    "family_rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "contract_version": {
      "type": "string"
    },
    "grammar_id": {
      "type": "string"
    },
    "grammar_badge": {
      "type": "string"
    },
    "basis_statement": {
      "type": "string"
    },
    "source_lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_file", "source_heading_or_logical_block", "rationale"],
        "properties": {
          "source_file": {
            "type": "string"
          },
          "source_heading_or_logical_block": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "family_rows": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": [
          "family_ref",
          "rail_label",
          "display_name",
          "primary_string_kind",
          "semantic_role",
          "durability_posture",
          "exposure_posture",
          "exact_fields",
          "suffix_rules",
          "lawful_examples",
          "allowed_producers",
          "allowed_consumers",
          "forbidden_substitutions",
          "notes"
        ],
        "properties": {
          "family_ref": {
            "type": "string"
          },
          "rail_label": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "primary_string_kind": {
            "type": "string"
          },
          "semantic_role": {
            "type": "string"
          },
          "durability_posture": {
            "type": "string"
          },
          "exposure_posture": {
            "type": "string"
          },
          "exact_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "suffix_rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lawful_examples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "allowed_producers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "allowed_consumers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "forbidden_substitutions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
