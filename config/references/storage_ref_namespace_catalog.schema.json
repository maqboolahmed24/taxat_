{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taxat.dev/config/references/storage_ref_namespace_catalog.schema.json",
  "title": "Storage Ref Namespace Catalog",
  "type": "object",
  "required": [
    "$schema",
    "contract_version",
    "catalog_id",
    "basis_statement",
    "source_lineage",
    "namespace_rows"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "contract_version": {
      "type": "string"
    },
    "catalog_id": {
      "type": "string"
    },
    "basis_statement": {
      "type": "string"
    },
    "source_lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_file", "source_heading_or_logical_block", "rationale"],
        "properties": {
          "source_file": {
            "type": "string"
          },
          "source_heading_or_logical_block": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "namespace_rows": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "namespace_ref",
          "purpose_ref",
          "storage_ref_prefix",
          "object_key_family_refs",
          "exposure_posture",
          "continuity_posture",
          "delivery_posture",
          "notes"
        ],
        "properties": {
          "namespace_ref": {
            "type": "string"
          },
          "purpose_ref": {
            "type": "string"
          },
          "storage_ref_prefix": {
            "type": "string"
          },
          "object_key_family_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "exposure_posture": {
            "type": "string"
          },
          "continuity_posture": {
            "type": "string"
          },
          "delivery_posture": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
