{
  "schema_version": "1.0",
  "policy_id": "artifact_naming_policy",
  "policy_version": "RELEASE_ARTIFACT_NAMING_POLICY_V1",
  "token_policy": {
    "separator": "__",
    "candidate_hash_short_length": 12,
    "schema_hash_short_length": 8,
    "config_hash_short_length": 8,
    "max_filename_length": 240,
    "registry_tag_policy": "DISCOVERY_TAGS_ONLY_DURABLE_IDENTITY_USES_DIGEST_PINNED_SUBJECT"
  },
  "collision_guard_policy": {
    "required_dimensions": [
      "component_slug",
      "release_channel_slug",
      "version_slug",
      "build_id",
      "candidate_identity_hash_short",
      "schema_bundle_hash_short",
      "config_bundle_hash_short",
      "rollout_posture_marker"
    ],
    "notes": [
      "Artifact filenames and registry tags must diverge whenever channel, build sequence, candidate tuple, or rollout posture changes.",
      "This closes the collision case where the same commit is rebuilt for a different channel or config bundle."
    ]
  },
  "primary_artifact_rows": [
    {
      "artifact_class_ref": "BACKEND_IMAGE",
      "artifact_family_ref": "API",
      "component_ref": "target.northbound-api-session-gateway",
      "component_slug": "api",
      "distribution_targets": [
        "SERVER"
      ],
      "registry_namespace_refs_by_channel": {
        "PREVIEW": "registry.preview.server",
        "SANDBOX": "registry.sandbox.server",
        "PREPRODUCTION": "registry.preproduction.server",
        "PRODUCTION": "registry.production.server"
      },
      "filename_template": "taxat-{component_slug}__{version_slug}__{build_id}__cih{candidate_hash_short}__sb{schema_hash_short}__cfg{config_hash_short}__{rollout_posture_marker}.img-ref.txt",
      "registry_tag_template": "{version_tag}--{build_id}--cih{candidate_hash_short}--{rollout_posture_marker}"
    },
    {
