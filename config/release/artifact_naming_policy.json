      },
      "filename_template": "taxat-{component_slug}__{version_slug}__{build_id}__cih{candidate_hash_short}__sb{schema_hash_short}__cfg{config_hash_short}__{rollout_posture_marker}.img-ref.txt",
      "registry_tag_template": "{version_tag}--{build_id}--cih{candidate_hash_short}--{rollout_posture_marker}"
