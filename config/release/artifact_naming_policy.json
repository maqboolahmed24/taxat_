      "registry_tag_template": "{version_tag}--{build_id}--cih{candidate_hash_short}--{rollout_posture_marker}",
      "desktop_companion_templates": {
        "desktop_notarization_ref": "taxat-{component_slug}__{version_slug}__{build_id}__cih{candidate_hash_short}.notary.json",
        "hardened_runtime_attestation_ref": "taxat-{component_slug}__{version_slug}__{build_id}__cih{candidate_hash_short}.hardened-runtime.json"
      }
