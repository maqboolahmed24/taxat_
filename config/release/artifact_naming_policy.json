  "companion_artifact_templates": {
    "sbom_ref": {
      "registry_namespace_ref": "registry.evidence.sbom",
      "filename_template": "taxat-{component_slug}__{version_slug}__{build_id}__cih{candidate_hash_short}.sbom.cdx.json",
      "registry_tag_template": "{version_tag}--{build_id}--cih{candidate_hash_short}"
    },
    "provenance_ref": {
      "registry_namespace_ref": "registry.evidence.provenance",
      "filename_template": "taxat-{component_slug}__{version_slug}__{build_id}__cih{candidate_hash_short}.provenance.intoto.jsonl",
      "registry_tag_template": "{version_tag}--{build_id}--cih{candidate_hash_short}"
    },
    "signature_ref": {
      "registry_strategy": "SAME_NAMESPACE_SIDE_CAR",
      "filename_template": "taxat-{component_slug}__{version_slug}__{build_id}__cih{candidate_hash_short}.sig",
      "registry_tag_suffix": ".sig"
    },
    "release_verification_manifest_ref": {
      "registry_namespace_ref": "registry.evidence.release-admission",
      "filename_template": "taxat-release-verification-manifest__{version_slug}__{build_id}__cih{candidate_hash_short}__sb{schema_hash_short}__cfg{config_hash_short}__{rollout_posture_marker}.json",
      "registry_tag_template": "{version_tag}--{build_id}--cih{candidate_hash_short}--manifest"
    }
  },
  "notes": [
    "Artifact filenames expose short candidate, schema, and config lineage so operators can tell apart config-only promotions without reading the full manifest.",
    "Registry coordinates stay digest-first for durable identity; tags remain discovery aids only."
  ]
}
