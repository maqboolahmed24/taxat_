{
  "contract_version": "OBJECT_CLASS_CATALOG_V1",
  "catalog_id": "object_class_catalog",
  "basis_statement": "Object classes keep staged bytes, quarantined bodies, retained evidence, customer-safe derivatives, and export bundles on explicit rails so raw storage location never becomes durable delivery truth.",
  "source_lineage": [
    {
      "source_file": "config/object_storage/bucket_purpose_matrix.json",
      "source_heading_or_logical_block": "purpose_rows",
      "rationale": "The bucket-purpose matrix already fixes the durable storage namespaces that object classes must align to."
    },
    {
      "source_file": "config/references/storage_ref_namespace_catalog.json",
      "source_heading_or_logical_block": "namespace_rows",
      "rationale": "Storage refs already distinguish upload staging, quarantine, retained evidence, derived previews, and export families."
    },
    {
      "source_file": "Algorithm/upload_session_recovery_harness_contract.md",
      "source_heading_or_logical_block": "Resume continuity",
      "rationale": "Upload-session recovery law requires the same storage ref across reconnect and rebase while the session remains lawful."
    }
  ],
  "object_class_rows": [
