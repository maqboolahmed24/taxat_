{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taxat.dev/schemas/code_quality_matrix.schema.json",
  "title": "Code Quality Matrix",
  "type": "object",
  "required": [
    "matrixVersion",
    "workspaceContextChip",
    "statusSentence",
    "stageLanes",
    "toolFamilies",
    "toolDefinitions",
    "areas"
  ],
  "properties": {
    "matrixVersion": {
      "type": "string"
    },
    "workspaceContextChip": {
      "type": "string"
    },
    "statusSentence": {
      "type": "string"
    },
    "stageLanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stageRef", "label", "summary"],
        "properties": {
          "stageRef": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "toolFamilies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["toolFamilyRef", "label", "summary"],
        "properties": {
          "toolFamilyRef": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "toolDefinitions": {
      "type": "array"
    },
    "areas": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
