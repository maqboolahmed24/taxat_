{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taxat.dev/schemas/generated_fixture_and_external_code_policy.schema.json",
  "title": "Generated Fixture And External Code Policy",
  "type": "object",
  "required": ["policyVersion", "pathPolicies"],
  "properties": {
    "policyVersion": {
      "type": "string"
    },
    "pathPolicies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "policyRef",
          "classification",
          "pathGlobs",
          "editPosture",
          "formatterPosture",
          "linterPosture",
          "typecheckPosture",
          "hookBehavior",
          "sourceOfTruth"
        ],
        "properties": {
          "policyRef": {
            "type": "string"
          },
          "classification": {
            "type": "string"
          },
          "pathGlobs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "editPosture": {
            "type": "string"
          },
          "formatterPosture": {
            "type": "string"
          },
          "linterPosture": {
            "type": "string"
          },
          "typecheckPosture": {
            "type": "string"
          },
          "hookBehavior": {
            "type": "string"
          },
          "sourceOfTruth": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
