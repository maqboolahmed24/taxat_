{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taxat.dev/schemas/secret_injection_policy.schema.json",
  "title": "Secret Injection Policy",
  "type": "object",
  "required": [
    "contract_version",
    "policy_id",
    "selected_backend",
    "handle_shape",
    "basis_statement",
    "local_bootstrap_policy",
    "consumer_resolution_ladders",
    "handle_env_keys",
    "typed_failure_modes"
  ],
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "policy_id": {
      "type": "string"
    },
    "selected_backend": {
      "type": "string"
    },
    "handle_shape": {
      "type": "string"
    },
    "basis_statement": {
      "type": "string"
    },
    "local_bootstrap_policy": {
      "type": "object",
      "required": [
        "env_key",
        "allowed_consumer_refs",
        "allowed_environment_refs",
        "required_format",
        "raw_value_fields_forbidden",
        "notes"
      ],
      "properties": {
        "env_key": {
          "type": "string"
        },
        "allowed_consumer_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_environment_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_format": {
          "type": "string"
        },
        "raw_value_fields_forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "consumer_resolution_ladders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["consumer_ref", "order", "live_env_fallback_after_freeze", "notes"],
        "properties": {
          "consumer_ref": {
            "type": "string"
          },
          "order": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "live_env_fallback_after_freeze": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "handle_env_keys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "env_key",
          "alias_ref",
          "secret_class",
          "allowed_consumer_refs",
          "allowed_environment_refs",
          "allowed_namespace_refs",
          "resolution_mode",
          "cache_policy",
          "notes"
        ],
        "properties": {
          "env_key": {
            "type": "string"
          },
          "alias_ref": {
            "type": "string"
          },
          "secret_class": {
            "type": "string"
          },
          "allowed_consumer_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed_environment_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed_namespace_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resolution_mode": {
            "type": "string"
          },
          "cache_policy": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "typed_failure_modes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "description"],
        "properties": {
          "code": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
