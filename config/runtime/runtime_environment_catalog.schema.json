{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taxat.dev/schemas/runtime_environment_catalog.schema.json",
  "title": "Runtime Environment Catalog",
  "type": "object",
  "required": [
    "contract_version",
    "catalog_id",
    "basis_statement",
    "runtime_key_catalog",
    "consumer_classes"
  ],
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "catalog_id": {
      "type": "string"
    },
    "basis_statement": {
      "type": "string"
    },
    "runtime_key_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "env_key",
          "value_kind",
          "classification",
          "required_for",
          "allowed_sources",
          "browser_safe",
          "description",
          "example"
        ],
        "properties": {
          "env_key": {
            "type": "string"
          },
          "value_kind": {
            "type": "string"
          },
          "classification": {
            "type": "string"
          },
          "required_for": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed_sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "browser_safe": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "example": {
            "type": "string"
          },
          "allowed_values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "consumer_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "consumer_ref",
          "label",
          "runtime_boundary",
          "frozen_config_mode",
          "basis_statement",
          "allowed_env_keys",
          "allowed_secret_keys",
          "forbidden_env_keys",
          "browser_safe_projection",
          "failure_modes",
          "notes"
        ],
        "properties": {
          "consumer_ref": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "runtime_boundary": {
            "type": "string"
          },
          "frozen_config_mode": {
            "type": "string"
          },
          "basis_statement": {
            "type": "string"
          },
          "allowed_env_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed_secret_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbidden_env_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "browser_safe_projection": {
            "type": "string"
          },
          "failure_modes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
