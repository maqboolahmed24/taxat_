{
  "contract_version": "1.0",
  "catalog_id": "runtime_environment_catalog",
  "basis_statement": "Bootstrap inputs are typed, secret handles stay opaque, and ConfigFreeze remains the only lawful post-seal execution basis.",
  "runtime_key_catalog": [
    {
      "env_key": "TAXAT_ENVIRONMENT_ID",
      "value_kind": "STRING",
      "classification": "RUNTIME_METADATA",
      "required_for": ["API", "WORKER", "CLI", "PYTHON", "PLAYWRIGHT", "NATIVE"],
      "allowed_sources": ["FROZEN_CONFIG", "EXPLICIT_OVERRIDE", "PROCESS_ENV"],
      "browser_safe": false,
      "description": "Canonical environment identifier selected from the environment catalog.",
      "example": "env_shared_sandbox_integration"
    },
    {
      "env_key": "TAXAT_PROVIDER_ENVIRONMENT",
      "value_kind": "ENUM",
      "classification": "RUNTIME_METADATA",
      "required_for": ["API", "WORKER", "CLI", "PYTHON", "PLAYWRIGHT"],
      "allowed_sources": ["FROZEN_CONFIG", "EXPLICIT_OVERRIDE", "PROCESS_ENV"],
      "browser_safe": false,
      "description": "Provider-environment posture for authority and callback traffic.",
      "example": "sandbox",
      "allowed_values": ["NONE", "sandbox", "production"]
    },
    {
      "env_key": "TAXAT_CONFIG_FREEZE_REF",
      "value_kind": "STRING",
      "classification": "FROZEN_CONFIG_METADATA",
      "required_for": ["API", "WORKER", "NATIVE"],
      "allowed_sources": ["FROZEN_CONFIG", "EXPLICIT_OVERRIDE"],
      "browser_safe": false,
      "description": "Opaque config-freeze reference that binds runtime code to one frozen execution basis.",
      "example": "cfg_2026_04_23_sandbox"
    },
    {
      "env_key": "TAXAT_CONFIG_FREEZE_HASH",
      "value_kind": "STRING",
      "classification": "FROZEN_CONFIG_METADATA",
      "required_for": ["API", "WORKER", "NATIVE"],
      "allowed_sources": ["FROZEN_CONFIG", "EXPLICIT_OVERRIDE"],
      "browser_safe": false,
      "description": "Hash of the authoritative ConfigFreeze artifact.",
      "example": "sha256:config-freeze-hash"
    },
    {
      "env_key": "TAXAT_CONFIG_SURFACE_HASH",
      "value_kind": "STRING",
      "classification": "FROZEN_CONFIG_METADATA",
      "required_for": ["API", "WORKER", "NATIVE"],
      "allowed_sources": ["FROZEN_CONFIG", "EXPLICIT_OVERRIDE"],
      "browser_safe": false,
      "description": "Hash of the canonical config surface carried through frozen execution binding.",
      "example": "sha256:config-surface-hash"
    },
    {
      "env_key": "TAXAT_CONFIG_CONSUMPTION_MODE",
      "value_kind": "ENUM",
      "classification": "FROZEN_CONFIG_METADATA",
      "required_for": ["API", "WORKER", "NATIVE"],
      "allowed_sources": ["FROZEN_CONFIG", "EXPLICIT_OVERRIDE"],
      "browser_safe": false,
      "description": "Explicit confirmation that post-seal consumers must use only frozen config.",
      "example": "FROZEN_CONFIG_ONLY",
      "allowed_values": ["FROZEN_CONFIG_ONLY"]
    },
    {
      "env_key": "TAXAT_HMRC_API_BASE_URL",
      "value_kind": "URL",
      "classification": "RUNTIME_METADATA",
      "required_for": ["WORKER", "CLI", "PLAYWRIGHT"],
      "allowed_sources": ["FROZEN_CONFIG", "EXPLICIT_OVERRIDE", "PROCESS_ENV"],
      "browser_safe": false,
      "description": "Authority gateway or provider-facing HMRC API base URL used to confirm environment compatibility.",
      "example": "https://test-api.service.hmrc.gov.uk"
    },
    {
      "env_key": "TAXAT_SESSION_IDLE_TIMEOUT_SECONDS",
      "value_kind": "INTEGER",
      "classification": "RUNTIME_METADATA",
      "required_for": ["API", "NATIVE"],
      "allowed_sources": ["FROZEN_CONFIG", "EXPLICIT_OVERRIDE", "PROCESS_ENV"],
      "browser_safe": false,
      "description": "Idle-session timeout in seconds for session-aware surfaces.",
      "example": "1200"
    },
    {
      "env_key": "TAXAT_ENABLE_STRICT_TRACE_REDACTION",
      "value_kind": "BOOLEAN",
      "classification": "RUNTIME_METADATA",
      "required_for": ["API", "WORKER", "CLI", "PYTHON", "PLAYWRIGHT"],
      "allowed_sources": ["FROZEN_CONFIG", "EXPLICIT_OVERRIDE", "PROCESS_ENV"],
      "browser_safe": false,
      "description": "Forces redaction-safe diagnostics and fail-closed trace capture rules.",
      "example": "true"
    },
    {
      "env_key": "TAXAT_LOCAL_SECRET_BOOTSTRAP_FILE",
      "value_kind": "PATH",
      "classification": "BOOTSTRAP_METADATA",
      "required_for": [],
      "allowed_sources": ["EXPLICIT_OVERRIDE", "PROCESS_ENV"],
      "browser_safe": false,
      "description": "Local-only JSON file carrying secret-handle refs for bootstrap workflows; never raw secret values.",
      "example": "/tmp/taxat-runtime-handles.json"
    },
    {
      "env_key": "TAXAT_BROWSER_PUBLIC_BASE_URL",
      "value_kind": "URL",
      "classification": "BROWSER_SAFE_METADATA",
      "required_for": ["BROWSER_BUILD", "PLAYWRIGHT", "NATIVE"],
      "allowed_sources": ["EXPLICIT_OVERRIDE", "PROCESS_ENV"],
      "browser_safe": true,
      "description": "Public browser origin exposed to browser bundles, Playwright, and native client shell code.",
      "example": "https://operator-preview-pr-42.review.taxat.example"
    },
    {
      "env_key": "TAXAT_BROWSER_PUBLIC_ENVIRONMENT_LABEL",
      "value_kind": "STRING",
      "classification": "BROWSER_SAFE_METADATA",
      "required_for": ["BROWSER_BUILD", "PLAYWRIGHT", "NATIVE"],
      "allowed_sources": ["EXPLICIT_OVERRIDE", "PROCESS_ENV"],
      "browser_safe": true,
      "description": "Human-readable environment label that can appear in browser or native UI copy.",
      "example": "Shared sandbox integration"
    },
    {
      "env_key": "TAXAT_BROWSER_PUBLIC_RELEASE_CHANNEL",
      "value_kind": "ENUM",
      "classification": "BROWSER_SAFE_METADATA",
      "required_for": ["BROWSER_BUILD", "PLAYWRIGHT", "NATIVE"],
      "allowed_sources": ["EXPLICIT_OVERRIDE", "PROCESS_ENV"],
      "browser_safe": true,
      "description": "Release channel surfaced to browser-visible shells without exposing broader runtime policy.",
      "example": "sandbox",
      "allowed_values": ["local", "preview", "sandbox", "preprod", "production"]
    },
    {
      "env_key": "TAXAT_BROWSER_PUBLIC_BUILD_SHA",
      "value_kind": "STRING",
      "classification": "BROWSER_SAFE_METADATA",
      "required_for": ["BROWSER_BUILD", "PLAYWRIGHT"],
      "allowed_sources": ["EXPLICIT_OVERRIDE", "PROCESS_ENV"],
      "browser_safe": true,
      "description": "Candidate-bound source revision exposed for browser-visible diagnostics.",
      "example": "3f6c9a2"
    },
    {
      "env_key": "TAXAT_BROWSER_PUBLIC_SENTRY_DSN",
      "value_kind": "STRING",
      "classification": "BROWSER_SAFE_METADATA",
      "required_for": [],
      "allowed_sources": ["EXPLICIT_OVERRIDE", "PROCESS_ENV"],
      "browser_safe": true,
      "description": "Optional public DSN or ingest endpoint safe for browser emission.",
      "example": "https://public@example.ingest.sentry.io/123456"
    },
    {
      "env_key": "TAXAT_SECRET_REF_POSTGRES_CONTROL_STORE_PASSWORD",
      "value_kind": "SECRET_HANDLE",
      "classification": "SECRET_HANDLE",
      "required_for": [],
      "allowed_sources": [
        "FROZEN_CONFIG",
        "EXPLICIT_OVERRIDE",
        "PROCESS_ENV",
        "LOCAL_FILE_BOOTSTRAP"
      ],
      "browser_safe": false,
      "description": "Opaque handle for the control-store password; never the raw credential.",
      "example": "{\"alias_ref\":\"alias.runtime.postgresql.control-store.password\",\"namespace_ref\":\"sec_sandbox_runtime\"}"
    },
    {
      "env_key": "TAXAT_SECRET_REF_POSTGRES_AUDIT_STORE_PASSWORD",
      "value_kind": "SECRET_HANDLE",
      "classification": "SECRET_HANDLE",
      "required_for": [],
      "allowed_sources": [
        "FROZEN_CONFIG",
        "EXPLICIT_OVERRIDE",
        "PROCESS_ENV",
        "LOCAL_FILE_BOOTSTRAP"
      ],
      "browser_safe": false,
      "description": "Opaque handle for the audit-store password; never the raw credential.",
      "example": "{\"alias_ref\":\"alias.runtime.postgresql.audit-store.password\",\"namespace_ref\":\"sec_sandbox_runtime\"}"
    },
    {
      "env_key": "TAXAT_SECRET_REF_IDP_BROWSER_CLIENT_SECRET",
      "value_kind": "SECRET_HANDLE",
      "classification": "SECRET_HANDLE",
      "required_for": [],
      "allowed_sources": [
        "FROZEN_CONFIG",
        "EXPLICIT_OVERRIDE",
        "PROCESS_ENV",
        "LOCAL_FILE_BOOTSTRAP"
      ],
      "browser_safe": false,
      "description": "Opaque handle for the confidential browser-client secret used by the identity boundary.",
      "example": "{\"alias_ref\":\"alias.identity.idp.browser.client-secret\",\"namespace_ref\":\"sec_sandbox_runtime\"}"
    },
    {
      "env_key": "TAXAT_SECRET_REF_HMRC_WEB_CLIENT_SECRET",
      "value_kind": "SECRET_HANDLE",
      "classification": "SECRET_HANDLE",
      "required_for": [],
      "allowed_sources": [
        "FROZEN_CONFIG",
        "EXPLICIT_OVERRIDE",
        "PROCESS_ENV",
        "LOCAL_FILE_BOOTSTRAP"
      ],
      "browser_safe": false,
      "description": "Opaque handle for the HMRC confidential web client secret used by the worker-side authority boundary.",
      "example": "{\"alias_ref\":\"alias.authority.hmrc.web.client-secret\",\"namespace_ref\":\"sec_sandbox_web_authority\"}"
    },
    {
      "env_key": "TAXAT_SECRET_REF_REDACTION_DICTIONARY",
      "value_kind": "SECRET_HANDLE",
      "classification": "SECRET_HANDLE",
      "required_for": [],
      "allowed_sources": ["EXPLICIT_OVERRIDE", "PROCESS_ENV", "LOCAL_FILE_BOOTSTRAP"],
      "browser_safe": false,
      "description": "Opaque metadata-only handle for the provisioning redaction dictionary shared by CLI and Python tooling.",
      "example": "{\"alias_ref\":\"alias.provisioning.redaction-dictionary\",\"namespace_ref\":\"sec_local_authoring\"}"
    }
  ],
  "consumer_classes": [
    {
      "consumer_ref": "API",
      "label": "API",
      "runtime_boundary": "SERVER_API",
      "frozen_config_mode": "REQUIRED_AFTER_FREEZE",
      "basis_statement": "Interactive request handling must switch to ConfigFreeze and manifest-bound secret handles as soon as a run is sealed.",
      "allowed_env_keys": [
        "TAXAT_ENVIRONMENT_ID",
        "TAXAT_PROVIDER_ENVIRONMENT",
        "TAXAT_CONFIG_FREEZE_REF",
        "TAXAT_CONFIG_FREEZE_HASH",
        "TAXAT_CONFIG_SURFACE_HASH",
        "TAXAT_CONFIG_CONSUMPTION_MODE",
        "TAXAT_SESSION_IDLE_TIMEOUT_SECONDS",
        "TAXAT_ENABLE_STRICT_TRACE_REDACTION"
      ],
      "allowed_secret_keys": [
        "TAXAT_SECRET_REF_POSTGRES_CONTROL_STORE_PASSWORD",
        "TAXAT_SECRET_REF_POSTGRES_AUDIT_STORE_PASSWORD",
        "TAXAT_SECRET_REF_IDP_BROWSER_CLIENT_SECRET"
      ],
      "forbidden_env_keys": [
        "TAXAT_LOCAL_SECRET_BOOTSTRAP_FILE",
        "TAXAT_BROWSER_PUBLIC_BASE_URL",
        "TAXAT_SECRET_REF_HMRC_WEB_CLIENT_SECRET"
      ],
      "browser_safe_projection": "FORBIDDEN",
      "failure_modes": [
        "RUNTIME_CONFIG_FREEZE_REQUIRED",
        "RUNTIME_ENV_KEY_MISSING",
        "RUNTIME_ENV_PROVIDER_MISMATCH",
        "RUNTIME_SECRET_HANDLE_FORBIDDEN"
      ],
      "notes": [
        "API reads runtime config and callback-verification secrets but never a browser bundle allowlist.",
        "Live process-env fallback becomes illegal once ConfigFreeze is present."
      ]
    },
    {
      "consumer_ref": "WORKER",
      "label": "WORKER",
      "runtime_boundary": "ASYNC_WORKER",
      "frozen_config_mode": "REQUIRED_AFTER_FREEZE",
      "basis_statement": "Workers may consume provider-facing config and authority secret handles, but only through manifest-bound frozen config after seal.",
      "allowed_env_keys": [
        "TAXAT_ENVIRONMENT_ID",
        "TAXAT_PROVIDER_ENVIRONMENT",
        "TAXAT_CONFIG_FREEZE_REF",
        "TAXAT_CONFIG_FREEZE_HASH",
        "TAXAT_CONFIG_SURFACE_HASH",
        "TAXAT_CONFIG_CONSUMPTION_MODE",
        "TAXAT_HMRC_API_BASE_URL",
        "TAXAT_ENABLE_STRICT_TRACE_REDACTION"
      ],
      "allowed_secret_keys": [
        "TAXAT_SECRET_REF_POSTGRES_CONTROL_STORE_PASSWORD",
        "TAXAT_SECRET_REF_POSTGRES_AUDIT_STORE_PASSWORD",
        "TAXAT_SECRET_REF_HMRC_WEB_CLIENT_SECRET"
      ],
      "forbidden_env_keys": [
        "TAXAT_LOCAL_SECRET_BOOTSTRAP_FILE",
        "TAXAT_BROWSER_PUBLIC_BASE_URL",
        "TAXAT_SECRET_REF_REDACTION_DICTIONARY"
      ],
      "browser_safe_projection": "FORBIDDEN",
      "failure_modes": [
        "RUNTIME_CONFIG_FREEZE_REQUIRED",
        "RUNTIME_ENV_KEY_MISSING",
        "RUNTIME_ENV_PROVIDER_MISMATCH",
        "RUNTIME_SECRET_HANDLE_FORBIDDEN"
      ],
      "notes": [
        "Worker lanes own authority traffic and may therefore consume HMRC client-secret handles.",
        "No worker may reload mutable policy from process env once ConfigFreeze exists."
      ]
    },
    {
      "consumer_ref": "CLI",
      "label": "CLI",
      "runtime_boundary": "CLI_AND_OPERATOR_TOOLING",
      "frozen_config_mode": "BOOTSTRAP_ALLOWED_UNTIL_MANIFEST_BOUND",
      "basis_statement": "CLI and operator tooling may bootstrap locally, but manifest-bound flows must still flip to frozen config and opaque handles.",
      "allowed_env_keys": [
        "TAXAT_ENVIRONMENT_ID",
        "TAXAT_PROVIDER_ENVIRONMENT",
        "TAXAT_HMRC_API_BASE_URL",
        "TAXAT_ENABLE_STRICT_TRACE_REDACTION",
        "TAXAT_LOCAL_SECRET_BOOTSTRAP_FILE"
      ],
      "allowed_secret_keys": ["TAXAT_SECRET_REF_REDACTION_DICTIONARY"],
      "forbidden_env_keys": [
        "TAXAT_BROWSER_PUBLIC_BASE_URL",
        "TAXAT_SECRET_REF_HMRC_WEB_CLIENT_SECRET",
        "TAXAT_SECRET_REF_POSTGRES_CONTROL_STORE_PASSWORD"
      ],
      "browser_safe_projection": "FORBIDDEN",
      "failure_modes": [
        "RUNTIME_ENV_KEY_MISSING",
        "RUNTIME_ENV_EMPTY",
        "RUNTIME_LOCAL_BOOTSTRAP_FORBIDDEN",
        "RUNTIME_SECRET_HANDLE_FORBIDDEN"
      ],
      "notes": [
        "CLI posture is intentionally narrower than runtime-worker posture.",
        "Local bootstrap files may carry only opaque handle refs and metadata."
      ]
    },
    {
      "consumer_ref": "PYTHON",
      "label": "PYTHON",
      "runtime_boundary": "PYTHON_VALIDATOR_TOOLING",
      "frozen_config_mode": "BOOTSTRAP_ALLOWED_UNTIL_VALIDATION_BINDING",
      "basis_statement": "Python validators and offline tooling reuse the same machine-readable runtime contract rather than inventing separate env semantics.",
      "allowed_env_keys": [
        "TAXAT_ENVIRONMENT_ID",
        "TAXAT_PROVIDER_ENVIRONMENT",
        "TAXAT_ENABLE_STRICT_TRACE_REDACTION",
        "TAXAT_LOCAL_SECRET_BOOTSTRAP_FILE"
      ],
      "allowed_secret_keys": ["TAXAT_SECRET_REF_REDACTION_DICTIONARY"],
      "forbidden_env_keys": [
        "TAXAT_BROWSER_PUBLIC_BASE_URL",
        "TAXAT_SECRET_REF_HMRC_WEB_CLIENT_SECRET",
        "TAXAT_SECRET_REF_POSTGRES_CONTROL_STORE_PASSWORD"
      ],
      "browser_safe_projection": "FORBIDDEN",
      "failure_modes": [
        "RUNTIME_ENV_KEY_MISSING",
        "RUNTIME_ENV_EMPTY",
        "RUNTIME_LOCAL_BOOTSTRAP_FORBIDDEN",
        "RUNTIME_SECRET_HANDLE_FORBIDDEN"
      ],
      "notes": [
        "Python tooling may consume only metadata-only or explicitly sanctioned handles.",
        "The Python helper reads the checked-in runtime contract files instead of shadow configs."
      ]
    },
    {
      "consumer_ref": "BROWSER_BUILD",
      "label": "BROWSER_BUILD",
      "runtime_boundary": "BROWSER_BUNDLE",
      "frozen_config_mode": "BROWSER_SAFE_ALLOWLIST_ONLY",
      "basis_statement": "Browser bundles may see only explicitly allowlisted non-secret values and can never import raw-secret or frozen-config loaders.",
      "allowed_env_keys": [
        "TAXAT_BROWSER_PUBLIC_BASE_URL",
        "TAXAT_BROWSER_PUBLIC_ENVIRONMENT_LABEL",
        "TAXAT_BROWSER_PUBLIC_RELEASE_CHANNEL",
        "TAXAT_BROWSER_PUBLIC_BUILD_SHA",
        "TAXAT_BROWSER_PUBLIC_SENTRY_DSN"
      ],
      "allowed_secret_keys": [],
      "forbidden_env_keys": [
        "TAXAT_ENVIRONMENT_ID",
        "TAXAT_PROVIDER_ENVIRONMENT",
        "TAXAT_CONFIG_FREEZE_REF",
        "TAXAT_SECRET_REF_POSTGRES_CONTROL_STORE_PASSWORD"
      ],
      "browser_safe_projection": "ALLOWLIST_ONLY",
      "failure_modes": ["RUNTIME_BROWSER_SAFE_KEY_FORBIDDEN", "RUNTIME_ENV_KEY_FORBIDDEN"],
      "notes": [
        "Browser bundles consume only values that are deliberately public or low-risk metadata.",
        "Any non-allowlisted key is a build-time policy violation."
      ]
    },
    {
      "consumer_ref": "PLAYWRIGHT",
      "label": "PLAYWRIGHT",
      "runtime_boundary": "BROWSER_AUTOMATION",
      "frozen_config_mode": "SANITIZED_BROWSER_AUTOMATION_ONLY",
      "basis_statement": "Playwright gets browser-safe env and provider base URLs, but it must never inherit the full runtime secret bag or raw client secrets.",
      "allowed_env_keys": [
        "TAXAT_ENVIRONMENT_ID",
        "TAXAT_PROVIDER_ENVIRONMENT",
        "TAXAT_HMRC_API_BASE_URL",
        "TAXAT_ENABLE_STRICT_TRACE_REDACTION",
        "TAXAT_LOCAL_SECRET_BOOTSTRAP_FILE",
        "TAXAT_BROWSER_PUBLIC_BASE_URL",
        "TAXAT_BROWSER_PUBLIC_ENVIRONMENT_LABEL",
        "TAXAT_BROWSER_PUBLIC_RELEASE_CHANNEL",
        "TAXAT_BROWSER_PUBLIC_BUILD_SHA"
      ],
      "allowed_secret_keys": [],
      "forbidden_env_keys": [
        "TAXAT_SECRET_REF_HMRC_WEB_CLIENT_SECRET",
        "TAXAT_SECRET_REF_IDP_BROWSER_CLIENT_SECRET",
        "TAXAT_SECRET_REF_POSTGRES_CONTROL_STORE_PASSWORD"
      ],
      "browser_safe_projection": "ALLOWLIST_PLUS_PROVIDER_METADATA",
      "failure_modes": [
        "RUNTIME_ENV_PROVIDER_MISMATCH",
        "RUNTIME_SECRET_HANDLE_FORBIDDEN",
        "RUNTIME_LOCAL_BOOTSTRAP_FORBIDDEN"
      ],
      "notes": [
        "Playwright may use operator-injected session state or browser-safe metadata, but not runtime bearer material.",
        "A present raw client-secret handle is a fail-closed configuration error."
      ]
    },
    {
      "consumer_ref": "NATIVE",
      "label": "NATIVE",
      "runtime_boundary": "NATIVE_ADJACENT_TOOLING",
      "frozen_config_mode": "REQUIRED_AFTER_FREEZE",
      "basis_statement": "Native-adjacent build or signed-app bootstrap paths may read browser-safe metadata and frozen-config identity, but never raw authority secrets.",
      "allowed_env_keys": [
        "TAXAT_ENVIRONMENT_ID",
        "TAXAT_CONFIG_FREEZE_REF",
        "TAXAT_CONFIG_FREEZE_HASH",
        "TAXAT_CONFIG_SURFACE_HASH",
        "TAXAT_CONFIG_CONSUMPTION_MODE",
        "TAXAT_SESSION_IDLE_TIMEOUT_SECONDS",
        "TAXAT_BROWSER_PUBLIC_BASE_URL",
        "TAXAT_BROWSER_PUBLIC_ENVIRONMENT_LABEL",
        "TAXAT_BROWSER_PUBLIC_RELEASE_CHANNEL"
      ],
      "allowed_secret_keys": [],
      "forbidden_env_keys": [
        "TAXAT_SECRET_REF_HMRC_WEB_CLIENT_SECRET",
        "TAXAT_SECRET_REF_IDP_BROWSER_CLIENT_SECRET",
        "TAXAT_LOCAL_SECRET_BOOTSTRAP_FILE"
      ],
      "browser_safe_projection": "BROWSER_SAFE_PLUS_FROZEN_CONFIG_METADATA",
      "failure_modes": [
        "RUNTIME_CONFIG_FREEZE_REQUIRED",
        "RUNTIME_ENV_KEY_MISSING",
        "RUNTIME_SECRET_HANDLE_FORBIDDEN"
      ],
      "notes": [
        "Native code remains Keychain- and system-browser-oriented; authority secrets stay server and vault bound.",
        "Frozen-config identity may flow into native diagnostics, but raw runtime handles may not."
      ]
    }
  ]
}
