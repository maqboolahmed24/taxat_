{
  "contract_version": "1.0",
  "policy_id": "secret_injection_policy",
  "selected_backend": "VAULT_OR_SECRET_MANAGER_HANDLE_ONLY",
  "handle_shape": "OPAQUE_REF_JSON_NO_RAW_VALUE",
  "basis_statement": "Runtime consumers receive opaque handle packets and resolve values through a provider boundary; they do not receive raw bearer material in env, logs, or browser-visible payloads.",
  "local_bootstrap_policy": {
    "env_key": "TAXAT_LOCAL_SECRET_BOOTSTRAP_FILE",
    "allowed_consumer_refs": ["CLI", "PYTHON", "PLAYWRIGHT"],
    "allowed_environment_refs": ["env_local_authoring", "env_local_provisioning_workstation"],
    "required_format": "JSON_OBJECT_OF_ENV_KEY_TO_HANDLE_PAYLOAD",
    "raw_value_fields_forbidden": [
      "value",
      "secret",
      "token",
      "client_secret",
      "password",
      "plaintext"
    ],
    "notes": [
      "Local bootstrap files may carry only opaque handle payloads, never raw credentials.",
      "The file is lawful only in local authoring or local provisioning environments."
    ]
  },
  "consumer_resolution_ladders": [
    {
      "consumer_ref": "API",
      "order": ["FROZEN_CONFIG", "EXPLICIT_OVERRIDE", "PROCESS_ENV"],
      "live_env_fallback_after_freeze": "FORBIDDEN",
      "notes": ["API consumers are manifest-bound once a ConfigFreeze exists."]
    },
    {
      "consumer_ref": "WORKER",
      "order": ["FROZEN_CONFIG", "EXPLICIT_OVERRIDE", "PROCESS_ENV"],
      "live_env_fallback_after_freeze": "FORBIDDEN",
      "notes": ["Workers use manifest-bound config and handle refs after seal."]
    },
    {
      "consumer_ref": "CLI",
      "order": ["EXPLICIT_OVERRIDE", "PROCESS_ENV", "LOCAL_FILE_BOOTSTRAP"],
      "live_env_fallback_after_freeze": "REJECT_WHEN_FROZEN_CONFIG_PRESENT",
      "notes": ["CLI may bootstrap locally, but frozen-manifest calls must stop live-env fallback."]
    },
    {
      "consumer_ref": "PYTHON",
      "order": ["EXPLICIT_OVERRIDE", "PROCESS_ENV", "LOCAL_FILE_BOOTSTRAP"],
      "live_env_fallback_after_freeze": "REJECT_WHEN_FROZEN_CONFIG_PRESENT",
      "notes": ["Python tooling follows the same bootstrap posture as CLI."]
    },
    {
      "consumer_ref": "BROWSER_BUILD",
      "order": ["EXPLICIT_OVERRIDE", "PROCESS_ENV"],
      "live_env_fallback_after_freeze": "NOT_APPLICABLE_BROWSER_SAFE_ONLY",
      "notes": ["Browser build consumes only allowlisted public metadata."]
    },
    {
      "consumer_ref": "PLAYWRIGHT",
      "order": ["EXPLICIT_OVERRIDE", "PROCESS_ENV", "LOCAL_FILE_BOOTSTRAP"],
      "live_env_fallback_after_freeze": "FORBIDDEN_FOR_SECRET_KEYS",
      "notes": [
        "Playwright may use local bootstrap for session-safe metadata but never runtime client secrets."
      ]
    },
    {
      "consumer_ref": "NATIVE",
      "order": ["FROZEN_CONFIG", "EXPLICIT_OVERRIDE", "PROCESS_ENV"],
      "live_env_fallback_after_freeze": "FORBIDDEN",
      "notes": [
        "Native-adjacent tooling inherits frozen-config identity and browser-safe metadata only."
      ]
    }
  ],
  "handle_env_keys": [
    {
      "env_key": "TAXAT_SECRET_REF_POSTGRES_CONTROL_STORE_PASSWORD",
      "alias_ref": "alias.runtime.postgresql.control-store.password",
      "secret_class": "RUNTIME_DATABASE_PASSWORD",
      "allowed_consumer_refs": ["API", "WORKER"],
      "allowed_environment_refs": [
        "env_shared_sandbox_integration",
        "env_preproduction_verification",
        "env_production"
      ],
      "allowed_namespace_refs": [
        "sec_sandbox_runtime",
        "sec_preprod_runtime",
        "sec_production_runtime"
      ],
      "resolution_mode": "HANDLE_REF_ONLY",
      "cache_policy": "ROTATION_AWARE_NO_STALE_REUSE",
      "notes": [
        "The control-store password remains runtime-only and cannot flow into browser, Python, or Playwright consumers."
      ]
    },
    {
      "env_key": "TAXAT_SECRET_REF_POSTGRES_AUDIT_STORE_PASSWORD",
      "alias_ref": "alias.runtime.postgresql.audit-store.password",
      "secret_class": "RUNTIME_DATABASE_PASSWORD",
      "allowed_consumer_refs": ["API", "WORKER"],
      "allowed_environment_refs": [
        "env_shared_sandbox_integration",
        "env_preproduction_verification",
        "env_production"
      ],
      "allowed_namespace_refs": [
        "sec_sandbox_runtime",
        "sec_preprod_runtime",
        "sec_production_runtime"
      ],
      "resolution_mode": "HANDLE_REF_ONLY",
      "cache_policy": "ROTATION_AWARE_NO_STALE_REUSE",
      "notes": [
        "Audit-store credentials follow the same runtime-only posture as control-store credentials."
      ]
    },
    {
      "env_key": "TAXAT_SECRET_REF_IDP_BROWSER_CLIENT_SECRET",
      "alias_ref": "alias.identity.idp.browser.client-secret",
      "secret_class": "IDP_CLIENT_SECRET",
      "allowed_consumer_refs": ["API"],
      "allowed_environment_refs": [
        "env_shared_sandbox_integration",
        "env_preproduction_verification",
        "env_production"
      ],
      "allowed_namespace_refs": [
        "sec_sandbox_runtime",
        "sec_preprod_runtime",
        "sec_production_runtime"
      ],
      "resolution_mode": "HANDLE_REF_ONLY",
      "cache_policy": "ROTATION_AWARE_NO_STALE_REUSE",
      "notes": [
        "The confidential browser-client secret belongs to the server-side identity boundary only."
      ]
    },
    {
      "env_key": "TAXAT_SECRET_REF_HMRC_WEB_CLIENT_SECRET",
      "alias_ref": "alias.authority.hmrc.web.client-secret",
      "secret_class": "AUTHORITY_CLIENT_SECRET",
      "allowed_consumer_refs": ["WORKER"],
      "allowed_environment_refs": [
        "env_shared_sandbox_integration",
        "env_preproduction_verification",
        "env_production"
      ],
      "allowed_namespace_refs": [
        "sec_sandbox_web_authority",
        "sec_preprod_web_authority",
        "sec_production_web_authority"
      ],
      "resolution_mode": "HANDLE_REF_ONLY",
      "cache_policy": "ROTATION_AWARE_NO_STALE_REUSE",
      "notes": [
        "Authority client secrets stay on the worker-side gateway boundary and are forbidden to Playwright, browser build, and native tooling."
      ]
    },
    {
      "env_key": "TAXAT_SECRET_REF_REDACTION_DICTIONARY",
      "alias_ref": "alias.provisioning.redaction-dictionary",
      "secret_class": "PROVISIONING_REDACTION_DICTIONARY",
      "allowed_consumer_refs": ["CLI", "PYTHON"],
      "allowed_environment_refs": ["env_local_authoring", "env_local_provisioning_workstation"],
      "allowed_namespace_refs": ["sec_local_authoring", "sec_local_provisioning_sandbox"],
      "resolution_mode": "METADATA_ONLY_HANDLE",
      "cache_policy": "NO_VALUE_CACHE_METADATA_ONLY",
      "notes": [
        "This handle is metadata-only and exists to keep Python and CLI tooling aligned with the same audited boundary."
      ]
    }
  ],
  "typed_failure_modes": [
    {
      "code": "RUNTIME_ENV_KEY_MISSING",
      "description": "A required environment key was absent for the selected consumer."
    },
    {
      "code": "RUNTIME_ENV_EMPTY",
      "description": "A present environment key resolved to an empty string and was rejected."
    },
    {
      "code": "RUNTIME_ENV_COERCION_FAILED",
      "description": "A value could not be parsed as its declared boolean, integer, URL, or enum shape."
    },
    {
      "code": "RUNTIME_ENV_PROVIDER_MISMATCH",
      "description": "Environment family, provider environment, namespace, or endpoint base URL did not align."
    },
    {
      "code": "RUNTIME_ENV_KEY_FORBIDDEN",
      "description": "A consumer received a configured environment key outside its declared runtime boundary."
    },
    {
      "code": "RUNTIME_SECRET_HANDLE_FORBIDDEN",
      "description": "A secret handle was supplied to a consumer or environment that is not allowed to read it."
    },
    {
      "code": "RUNTIME_SECRET_HANDLE_RAW_VALUE_FORBIDDEN",
      "description": "A handle payload contained raw secret material instead of opaque refs and metadata."
    },
    {
      "code": "RUNTIME_LOCAL_BOOTSTRAP_FORBIDDEN",
      "description": "A local bootstrap file was requested outside a local-only environment or consumer class."
    },
    {
      "code": "RUNTIME_CONFIG_FREEZE_REQUIRED",
      "description": "A manifest-governed consumer attempted to operate without frozen-config identity."
    },
    {
      "code": "RUNTIME_BROWSER_SAFE_KEY_FORBIDDEN",
      "description": "A browser-safe projection attempted to expose a key that is not explicitly allowlisted."
    }
  ]
}
