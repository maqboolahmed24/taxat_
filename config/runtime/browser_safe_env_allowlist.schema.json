{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taxat.dev/schemas/browser_safe_env_allowlist.schema.json",
  "title": "Browser Safe Env Allowlist",
  "type": "object",
  "required": [
    "contract_version",
    "allowlist_id",
    "basis_statement",
    "browser_safe_keys",
    "forbidden_key_prefixes"
  ],
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "allowlist_id": {
      "type": "string"
    },
    "basis_statement": {
      "type": "string"
    },
    "browser_safe_keys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["env_key", "label", "exposure_class", "allowed_consumer_refs", "notes"],
        "properties": {
          "env_key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "exposure_class": {
            "type": "string"
          },
          "allowed_consumer_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "forbidden_key_prefixes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
