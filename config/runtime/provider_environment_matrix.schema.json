{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taxat.dev/schemas/provider_environment_matrix.schema.json",
  "title": "Provider Environment Matrix",
  "type": "object",
  "required": ["contract_version", "matrix_id", "basis_statement", "environment_rows"],
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "matrix_id": {
      "type": "string"
    },
    "basis_statement": {
      "type": "string"
    },
    "environment_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "environment_ref",
          "environment_label",
          "provider_environment_ref",
          "allowed_consumer_refs",
          "allowed_namespace_refs",
          "hmrc_base_url_patterns",
          "browser_public_origin_patterns",
          "stable_callback_host_required",
          "frozen_config_required",
          "local_bootstrap_allowed",
          "notes"
        ],
        "properties": {
          "environment_ref": {
            "type": "string"
          },
          "environment_label": {
            "type": "string"
          },
          "provider_environment_ref": {
            "type": "string"
          },
          "allowed_consumer_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed_namespace_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hmrc_base_url_patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "browser_public_origin_patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stable_callback_host_required": {
            "type": "boolean"
          },
          "frozen_config_required": {
            "type": "boolean"
          },
          "local_bootstrap_allowed": {
            "type": "boolean"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
