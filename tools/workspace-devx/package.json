{
  "name": "@taxat/workspace-devx",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Workspace bootstrap, task stubs, and topology atlas generation for the Taxat monorepo.",
  "scripts": {
    "build": "node ./scripts/workspace-task-stub.mjs build tools/workspace-devx",
    "generate": "node ./scripts/build-workspace-topology-atlas.mjs",
    "lint": "node ./scripts/workspace-task-stub.mjs lint tools/workspace-devx",
    "test": "node ./scripts/workspace-task-stub.mjs test tools/workspace-devx",
    "typecheck": "node ./scripts/workspace-task-stub.mjs typecheck tools/workspace-devx"
  },
  "taxatWorkspace": {
    "family": "SHARED_PACKAGES",
    "ownerTeam": "@taxat/foundations-contracts",
    "packageId": "workspace-devx",
    "status": "BOOTSTRAPPED",
    "taskFamilies": [
      "build",
      "generate",
      "lint",
      "test",
      "typecheck"
    ]
  }
}
