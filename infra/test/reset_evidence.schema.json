{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ephemeral Reset Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_version",
    "action_kind",
    "environment_id",
    "environment_identity_hash",
    "environment_ref",
    "reset_scope_ref",
    "seed_profile_ref",
    "seed_profile_hash",
    "golden_pack_hash",
    "approved_target_pattern",
    "chronology",
    "resource_counts",
    "residual_warnings",
    "outcome",
    "source_lineage"
  ],
  "properties": {
    "evidence_version": {
      "const": "EPHEMERAL_RESET_EVIDENCE_V1"
    },
    "action_kind": {
      "enum": [
        "RESET",
        "DESTROY"
      ]
    },
    "environment_id": {
      "type": "string",
      "pattern": "^env-ephemeral-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "environment_identity_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "environment_ref": {
      "type": "string"
    },
    "reset_scope_ref": {
      "type": "string"
    },
    "seed_profile_ref": {
      "type": "string"
    },
    "seed_profile_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "golden_pack_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approved_target_pattern": {
      "type": "string"
    },
    "chronology": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "event_ref",
          "status",
          "detail"
        ],
        "properties": {
          "at": {
            "type": "string"
          },
          "event_ref": {
            "type": "string"
          },
          "status": {
            "enum": [
              "SUCCEEDED",
              "HALTED",
              "FAILED"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "resource_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_worker_leases",
        "queue_message_count",
        "cache_key_count",
        "projection_count",
        "stream_cursor_count",
        "upload_session_count",
        "object_prefix_object_count_total"
      ],
      "properties": {
        "active_worker_leases": {
          "type": "integer",
          "minimum": 0
        },
        "queue_message_count": {
          "type": "integer",
          "minimum": 0
        },
        "cache_key_count": {
          "type": "integer",
          "minimum": 0
        },
        "projection_count": {
          "type": "integer",
          "minimum": 0
        },
        "stream_cursor_count": {
          "type": "integer",
          "minimum": 0
        },
        "upload_session_count": {
          "type": "integer",
          "minimum": 0
        },
        "object_prefix_object_count_total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "residual_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcome": {
      "enum": [
        "SUCCEEDED",
        "HALTED",
        "FAILED"
      ]
    },
    "source_lineage": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  }
}
