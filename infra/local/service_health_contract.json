{
  "contract_version": "LOCAL_SERVICE_HEALTH_CONTRACT_V1",
  "health_contract_id": "taxat_local_service_health_contract",
  "basis_statement": "Local readiness is semantic. Base services must be healthy, bootstrap helpers must complete successfully, and deterministic state markers must prove schema, bucket, queue, cache, seed, validator, and smoke posture before host processes start.",
  "checks": [
    {
      "check_ref": "control-store.base",
      "readiness_class": "BASE",
      "service_ref": "CONTROL_STORE",
      "compose_service_ref_or_null": "postgres",
      "requirement_kind": "COMPOSE_RUNNING_HEALTHY",
      "marker_ref_or_null": null,
      "expected_string_or_null": null,
      "expected_values_or_null": null,
      "readiness_code": "CONTROL_STORE_PROCESS_READY",
      "failure_code": "CONTROL_STORE_PROCESS_DOWN",
      "notes": ["The shared PostgreSQL service must be healthy before bootstrap can apply schemas."]
    },
    {
      "check_ref": "object-storage.base",
      "readiness_class": "BASE",
      "service_ref": "OBJECT_STORAGE",
      "compose_service_ref_or_null": "minio",
      "requirement_kind": "COMPOSE_RUNNING_HEALTHY",
      "marker_ref_or_null": null,
      "expected_string_or_null": null,
      "expected_values_or_null": null,
      "readiness_code": "OBJECT_STORAGE_PROCESS_READY",
      "failure_code": "OBJECT_STORAGE_PROCESS_DOWN",
      "notes": ["Bucket bootstrap must not begin until the S3-compatible endpoint is healthy."]
    },
    {
      "check_ref": "queue.base",
      "readiness_class": "BASE",
      "service_ref": "QUEUE",
      "compose_service_ref_or_null": "rabbitmq",
      "requirement_kind": "COMPOSE_RUNNING_HEALTHY",
      "marker_ref_or_null": null,
      "expected_string_or_null": null,
      "expected_values_or_null": null,
      "readiness_code": "QUEUE_PROCESS_READY",
      "failure_code": "QUEUE_PROCESS_DOWN",
      "notes": ["The broker must be reachable before queue namespace bootstrap runs."]
    },
    {
      "check_ref": "cache.base",
      "readiness_class": "BASE",
      "service_ref": "CACHE",
      "compose_service_ref_or_null": "redis",
      "requirement_kind": "COMPOSE_RUNNING_HEALTHY",
      "marker_ref_or_null": null,
      "expected_string_or_null": null,
      "expected_values_or_null": null,
      "readiness_code": "CACHE_PROCESS_READY",
      "failure_code": "CACHE_PROCESS_DOWN",
      "notes": ["The disposable cache service must be healthy before sentinel namespaces are written."]
    },
    {
      "check_ref": "control-store.bootstrap",
      "readiness_class": "SEMANTIC",
      "service_ref": "CONTROL_STORE",
      "compose_service_ref_or_null": "postgres-bootstrap",
      "requirement_kind": "COMPOSE_EXITED_ZERO",
      "marker_ref_or_null": null,
      "expected_string_or_null": null,
      "expected_values_or_null": null,
      "readiness_code": "CONTROL_SCHEMA_BOOTSTRAPPED",
      "failure_code": "CONTROL_SCHEMA_BOOTSTRAP_FAILED",
      "notes": ["Migrations must apply cleanly before the control store counts as semantically ready."]
    },
    {
      "check_ref": "control-store.schema-bundle",
      "readiness_class": "SEMANTIC",
      "service_ref": "CONTROL_STORE",
      "compose_service_ref_or_null": null,
      "requirement_kind": "STATE_MARKER_EQUALS",
      "marker_ref_or_null": "control_store_schema_bundle_hash",
      "expected_string_or_null": "95b977085cc49325a17ae82e81d2e151f57d228682a538b3e3191e9c2d218b7d",
      "expected_values_or_null": null,
      "readiness_code": "CONTROL_SCHEMA_BUNDLE_ALIGNED",
      "failure_code": "CONTROL_SCHEMA_BUNDLE_MISMATCH",
      "notes": ["Schema drift must fail closed before host processes start."]
    },
    {
      "check_ref": "audit-store.appendability",
      "readiness_class": "SEMANTIC",
      "service_ref": "AUDIT_STORE",
      "compose_service_ref_or_null": null,
      "requirement_kind": "STATE_MARKER_EQUALS",
      "marker_ref_or_null": "audit_append_probe_ready",
      "expected_string_or_null": true,
      "expected_values_or_null": null,
      "readiness_code": "AUDIT_APPENDABILITY_CONFIRMED",
      "failure_code": "AUDIT_APPENDABILITY_UNCONFIRMED",
      "notes": ["Appendability remains an explicit semantic gate, not an assumption."]
    },
    {
      "check_ref": "object-storage.bootstrap",
      "readiness_class": "SEMANTIC",
      "service_ref": "OBJECT_STORAGE",
      "compose_service_ref_or_null": "minio-bootstrap",
      "requirement_kind": "COMPOSE_EXITED_ZERO",
      "marker_ref_or_null": null,
      "expected_string_or_null": null,
      "expected_values_or_null": null,
      "readiness_code": "OBJECT_STORAGE_BOOTSTRAPPED",
      "failure_code": "OBJECT_STORAGE_BOOTSTRAP_FAILED",
      "notes": ["Bucket creation and versioning enablement must succeed before seeding."]
    },
    {
      "check_ref": "object-storage.buckets",
      "readiness_class": "SEMANTIC",
      "service_ref": "OBJECT_STORAGE",
      "compose_service_ref_or_null": null,
      "requirement_kind": "STATE_MARKER_INCLUDES_ALL",
      "marker_ref_or_null": "object_storage_bucket_refs",
      "expected_string_or_null": null,
      "expected_values_or_null": [
        "taxat-local-upload-staging",
        "taxat-local-retained-evidence",
        "taxat-local-authority-payloads",
        "taxat-local-quarantine",
        "taxat-local-derived-previews",
        "taxat-local-masked-exports",
        "taxat-local-restricted-exports",
        "taxat-local-restore-archive"
      ],
      "readiness_code": "OBJECT_STORAGE_BUCKETS_PRESENT",
      "failure_code": "OBJECT_STORAGE_BUCKET_MISSING",
      "notes": ["Every governed bucket must exist before object workflows begin."]
    },
    {
      "check_ref": "queue.bootstrap",
      "readiness_class": "SEMANTIC",
      "service_ref": "QUEUE",
      "compose_service_ref_or_null": "rabbitmq-bootstrap",
      "requirement_kind": "COMPOSE_EXITED_ZERO",
      "marker_ref_or_null": null,
      "expected_string_or_null": null,
      "expected_values_or_null": null,
      "readiness_code": "QUEUE_BOOTSTRAPPED",
      "failure_code": "QUEUE_BOOTSTRAP_FAILED",
      "notes": ["Queue namespace and DLQ creation must complete before workers start."]
    },
    {
      "check_ref": "queue.namespaces",
      "readiness_class": "SEMANTIC",
      "service_ref": "QUEUE",
      "compose_service_ref_or_null": null,
      "requirement_kind": "STATE_MARKER_INCLUDES_ALL",
      "marker_ref_or_null": "queue_namespace_refs",
      "expected_string_or_null": null,
      "expected_values_or_null": [
        "queue.stage-work",
        "queue.authority-transmit",
        "queue.reconciliation-follow-up",
        "queue.projection-refresh",
        "queue.recovery-job",
        "dlq.stage-work",
        "dlq.authority-transmit",
        "dlq.reconciliation-follow-up",
        "dlq.projection-refresh",
        "dlq.recovery-job"
      ],
      "readiness_code": "QUEUE_NAMESPACES_PRESENT",
      "failure_code": "QUEUE_NAMESPACE_MISSING",
      "notes": ["Broker transport remains disposable, but namespace drift must still be explicit."]
    },
    {
      "check_ref": "cache.bootstrap",
      "readiness_class": "SEMANTIC",
      "service_ref": "CACHE",
      "compose_service_ref_or_null": "redis-bootstrap",
      "requirement_kind": "COMPOSE_EXITED_ZERO",
      "marker_ref_or_null": null,
      "expected_string_or_null": null,
      "expected_values_or_null": null,
      "readiness_code": "CACHE_BOOTSTRAPPED",
      "failure_code": "CACHE_BOOTSTRAP_FAILED",
      "notes": ["Cache sentinel creation proves the disposable namespaces were initialized intentionally."]
    },
    {
      "check_ref": "cache.namespaces",
      "readiness_class": "SEMANTIC",
      "service_ref": "CACHE",
      "compose_service_ref_or_null": null,
      "requirement_kind": "STATE_MARKER_INCLUDES_ALL",
      "marker_ref_or_null": "cache_namespace_refs",
      "expected_string_or_null": null,
      "expected_values_or_null": [
        "taxat:local:shared-cache",
        "taxat:local:resume-envelope",
        "taxat:local:native-hydration"
      ],
      "readiness_code": "CACHE_NAMESPACES_PRESENT",
      "failure_code": "CACHE_NAMESPACE_DRIFT",
      "notes": ["Cache drift is purge-and-rebuild, never durable mutation."]
    },
    {
      "check_ref": "host.seed-profile",
      "readiness_class": "SEMANTIC",
      "service_ref": "APP",
      "compose_service_ref_or_null": null,
      "requirement_kind": "STATE_MARKER_NON_EMPTY",
      "marker_ref_or_null": "seed_profile_ref",
      "expected_string_or_null": null,
      "expected_values_or_null": null,
      "readiness_code": "SEED_PROFILE_APPLIED",
      "failure_code": "SEED_PROFILE_MISSING",
      "notes": ["Host processes may not start from an unseeded local runtime."]
    },
    {
      "check_ref": "host.validators",
      "readiness_class": "SEMANTIC",
      "service_ref": "APP",
      "compose_service_ref_or_null": null,
      "requirement_kind": "STATE_MARKER_EQUALS",
      "marker_ref_or_null": "validator_status",
      "expected_string_or_null": "PASSED",
      "expected_values_or_null": null,
      "readiness_code": "AUTHORITATIVE_VALIDATORS_PASSED",
      "failure_code": "AUTHORITATIVE_VALIDATORS_NOT_PASSED",
      "notes": ["The local stack keeps the authoritative corpus validators in the normal smoke path by default."]
    },
    {
      "check_ref": "host.command-smoke",
      "readiness_class": "SEMANTIC",
      "service_ref": "APP",
      "compose_service_ref_or_null": null,
      "requirement_kind": "STATE_MARKER_EQUALS",
      "marker_ref_or_null": "smoke_command_path",
      "expected_string_or_null": "PASS",
      "expected_values_or_null": null,
      "readiness_code": "COMMAND_SMOKE_PASSED",
      "failure_code": "COMMAND_SMOKE_FAILED",
      "notes": ["Northbound receipt path must pass before host processes can be treated as ready."]
    },
    {
      "check_ref": "worker.queue-smoke",
      "readiness_class": "SEMANTIC",
      "service_ref": "WORKERS",
      "compose_service_ref_or_null": null,
      "requirement_kind": "STATE_MARKER_EQUALS",
      "marker_ref_or_null": "smoke_queue_path",
      "expected_string_or_null": "PASS",
      "expected_values_or_null": null,
      "readiness_code": "QUEUE_SMOKE_PASSED",
      "failure_code": "QUEUE_SMOKE_FAILED",
      "notes": ["Worker queues must prove claim and ack behavior before local workers start."]
    },
    {
      "check_ref": "worker.audit-smoke",
      "readiness_class": "SEMANTIC",
      "service_ref": "WORKERS",
      "compose_service_ref_or_null": null,
      "requirement_kind": "STATE_MARKER_EQUALS",
      "marker_ref_or_null": "smoke_audit_path",
      "expected_string_or_null": "PASS",
      "expected_values_or_null": null,
      "readiness_code": "AUDIT_SMOKE_PASSED",
      "failure_code": "AUDIT_SMOKE_FAILED",
      "notes": ["Worker start depends on append-only audit continuity remaining healthy."]
    }
  ]
}
