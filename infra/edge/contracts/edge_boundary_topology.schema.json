{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taxat.dev/schemas/edge_boundary_topology.schema.json",
  "title": "Taxat edge boundary topology",
  "type": "object",
  "required": [
    "schema_version",
    "matrix_id",
    "selection_status",
    "selected_provider_family",
    "host_origin_rows"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "matrix_id": {
      "const": "dns_and_origin_matrix"
    },
    "selection_status": {
      "enum": [
        "PROVIDER_DEFAULT_APPLIED",
        "PROVIDER_CONFIRMED"
      ]
    },
    "selected_provider_family": {
      "enum": [
        "CLOUDFLARE_DNS_SSL_WAF_CACHE_RULES",
        "AWS_ROUTE53_CLOUDFRONT_AWS_WAF",
        "FASTLY_DNS_TLS_WAF_COMPOSITE"
      ]
    },
    "host_origin_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "row_ref",
          "label",
          "surface_family_ref",
          "environment_ref",
          "hostname",
          "path_glob",
          "origin_class_ref",
          "origin_target",
          "tls_policy_ref",
          "waf_policy_ref",
          "cache_policy_ref"
        ]
      }
    }
  }
}
